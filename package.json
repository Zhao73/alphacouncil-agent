{
  "name": "alphacouncil-agent",
  "version": "0.9.1",
  "description": "Multi-agent public-equity research workflow plugin for Codex & Claude Code: sourced evidence packets, bull/bear debate, and a portfolio-manager Buy/Overweight/Hold/Underweight/Sell decision.",
  "type": "module",
  "license": "MIT",
  "author": "Zhao73",
  "homepage": "https://github.com/Zhao73/alphacouncil-agent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zhao73/alphacouncil-agent.git"
  },
  "bugs": {
    "url": "https://github.com/Zhao73/alphacouncil-agent/issues"
  },
  "keywords": [
    "codex",
    "claude-code",
    "mcp",
    "equity-research",
    "investing",
    "multi-agent",
    "plugin"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "check": "node scripts/selfcheck.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:source": "node --test",
    "test:package": "node scripts/package-smoke.mjs",
    "sync": "node scripts/sync-personas.mjs",
    "persona:corpus": "node scripts/report-persona-corpus-gaps.mjs",
    "persona:build-specs": "node scripts/report-persona-v3-build-specs.mjs",
    "persona:compile": "node scripts/compile-persona-packs.mjs",
    "persona:ga": "node scripts/check-persona-v3-ga.mjs",
    "persona:release:assemble": "node scripts/assemble-persona-v3-release.mjs",
    "persona:release:promote": "node scripts/promote-persona-v3-release.mjs",
    "persona:release:evidence:check": "node scripts/check-persona-v3-ga.mjs --expected-version 0.9.0 --require-release-evidence",
    "release:check": "npm run check && node scripts/check-persona-v3-ga.mjs --expected-version 0.9.0 --require-count 26 --require-min-admission operational --forbid-legacy --forbid-prompt-lens --require-release-evidence",
    "release:preview:check": "npm run check && npm run test:package",
    "persona:stage:init": "node scripts/scaffold-persona-v3-staging.mjs --write",
    "persona:stage:check": "node scripts/scaffold-persona-v3-staging.mjs --check",
    "persona:stage:report": "node scripts/report-persona-v3-staging.mjs",
    "persona:candidates:check": "node scripts/check-persona-v3-production-candidates.mjs --check",
    "persona:candidates:gate": "node scripts/check-persona-v3-production-candidates.mjs --gate",
    "persona:source:acquire": "node scripts/acquire-persona-source.mjs",
    "persona:source:check": "node scripts/acquire-persona-source.mjs --check",
    "persona:source:ai-prereview:check": "node scripts/pre-review-persona-sources.mjs --check",
    "persona:source:ai-prereview:write": "node scripts/pre-review-persona-sources.mjs --write",
    "persona:source:semantic:check": "node scripts/extract-persona-source-semantics.mjs --check",
    "persona:source:semantic:write": "node scripts/extract-persona-source-semantics.mjs --write",
    "persona:source:semantic:skeptic:check": "node scripts/review-persona-source-semantics.mjs --check",
    "persona:source:semantic:skeptic:write": "node scripts/review-persona-source-semantics.mjs --write",
    "persona:source:semantic:adjudicator:check": "node scripts/adjudicate-persona-source-semantics.mjs --check",
    "persona:source:semantic:adjudicator:write": "node scripts/adjudicate-persona-source-semantics.mjs --write",
    "persona:drafts:check": "node scripts/generate-persona-v3-drafts.mjs --check",
    "persona:drafts:write": "node scripts/generate-persona-v3-drafts.mjs --write",
    "persona:formulas:check": "node scripts/compile-persona-v3-formulas.mjs --check",
    "persona:formulas:write": "node scripts/compile-persona-v3-formulas.mjs --write",
    "persona:solo-test:formulas:check": "node scripts/compile-persona-v3-formulas.mjs --compile-solo-test",
    "persona:solo-test:formulas:build": "node scripts/compile-persona-v3-formulas.mjs --compile-solo-test --write",
    "persona:solo-test:formulas:ai-review:check": "node scripts/review-persona-v3-solo-formulas.mjs --check",
    "persona:solo-test:formulas:ai-review:write": "node scripts/review-persona-v3-solo-formulas.mjs --write",
    "persona:solo-test:check": "node scripts/build-persona-v3-solo-test-packs.mjs --check",
    "persona:solo-test:build": "node scripts/build-persona-v3-solo-test-packs.mjs --write",
    "persona:ai-assisted:status": "node scripts/check-persona-v3-ai-assisted-solo.mjs --status",
    "persona:ai-assisted:check": "node scripts/check-persona-v3-ai-assisted-solo.mjs --check",
    "persona:ai-assisted:gate": "node scripts/check-persona-v3-ai-assisted-solo.mjs --gate",
    "persona:ai-simulations:check": "node scripts/run-persona-v3-ai-machine-simulations.mjs --check",
    "persona:ai-simulations:write": "node scripts/run-persona-v3-ai-machine-simulations.mjs --write",
    "persona:source:adjudication": "node scripts/adjudicate-persona-source.mjs",
    "persona:source:review-batch": "node scripts/export-persona-source-review-batch.mjs",
    "persona:source:review:sign": "node scripts/sign-persona-source-review.mjs",
    "host:capabilities": "node scripts/report-host-capabilities.mjs --check",
    "host:package:check": "node scripts/check-packaged-host-parity.mjs --check",
    "evaluation:protocol": "node scripts/report-council-evaluation-protocol.mjs --markdown",
    "evaluation:artifacts": "node scripts/council-experiment-artifacts.mjs --plan",
    "evaluation:artifacts:check": "node scripts/council-experiment-artifacts.mjs --check",
    "host:e2e:artifacts": "node scripts/host-e2e-artifacts.mjs --plan",
    "host:e2e:artifacts:check": "node scripts/host-e2e-artifacts.mjs --check",
    "prepublishOnly": "npm run check && npm run test:package"
  },
  "bin": {
    "alphacouncil-agent": "mcp/server.mjs"
  },
  "files": [
    "mcp/",
    "personas/",
    "knowledge/masters/",
    "knowledge/solo-test/",
    "knowledge/ai-assisted-solo/experiments/",
    "knowledge/ai-assisted-solo/reviews/",
    "test/fixtures/options-chain-synthetic.json",
    "test/fixtures/nok-grounding-production-shape.json",
    "knowledge/persona-releases/",
    "scripts/",
    "data/",
    "skills/",
    "docs/report-contract.md",
    "docs/personas.md",
    "docs/attribution.md",
    ".claude-plugin/",
    ".codex-plugin/",
    "assets/logo-icon.png",
    "codex.mcp.json",
    "opencode.json",
    "CHANGELOG.md",
    ".grok/config.toml",
    ".grok/agents/",
    ".opencode/agent/",
    ".claude/agents/",
    "AGENTS.md",
    "CLAUDE.md",
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "README.ja.md",
    "PRODUCT.md",
    "commands/",
    ".claude/commands/",
    ".opencode/command/",
    ".grok/commands/",
    "docs/INSTALL.md",
    "docs/plans/",
    "docs/releases/",
    "docs/evaluation/",
    "docs/persona-v3-staging.md",
    "docs/persona-v3-deterministic-policy.md",
    "docs/persona-v3-drafts.md",
    "docs/persona-v3-formula-authoring.md",
    "docs/persona-v3-ai-formula-review.md",
    "docs/persona-v3-ai-assisted-solo.md",
    "docs/persona-v3-production-candidates.md",
    "docs/persona-v3-source-adjudication.md",
    "docs/solo-test-0.9.0.md",
    "docs/roadmap.md",
    "schemas/",
    "docs/persona-v2-spec.md",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ]
}
