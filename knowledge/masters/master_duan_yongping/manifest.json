      "confidence": "high",
      "counterexamples": ["已充分理解且价格明显低于价值时不适用"],
      "version": 1
    },
    {
      "rule_id": "duan.opportunity_cost.01",
      "claim": "任何买入都要与当前最好的已持有标的比较；比不过就不买",
      "scope": ["portfolio"],
