      "confidence": "high",
      "counterexamples": [],
      "version": 1
    },
    {
      "rule_id": "duan.business_model_first.01",
      "claim": "商业模式优先于财务指标：先判断生意本身是否好，再谈价格",
      "scope": ["public_equity"],
      "trigger": "valuation_requested",
