    },
    {
      "rule_id": "duan.stop_doing_list.01",
      "claim": "停止做不对的事情，比多做正确的事情更重要；默认不行动",
      "scope": ["public_equity", "portfolio"],
      "trigger": "no_clear_edge",
      "action": "downweight",
