{
  "build_profile": "solo_test",
  "capability": {
    "domains": [
      "capital_preservation",
      "distressed_value",
      "complex_securities",
      "catalyst_value"
    ],
    "exclusions": [
      "Baupost private letters or positions",
      "leaked material treated as an authorized source",
      "relative-performance pressure imported into the method",
      "production decisions",
      "method attribution"
    ],
    "native_decision_schema": "capital_preservation_v1",
    "optional_fact_types": [
      "financial.leverage",
      "financial.interest_coverage",
      "distress.recovery_waterfall",
      "capital_structure.seniority",
      "catalyst.path",
      "portfolio.cash_optionality",
      "trade.liquidity",
      "risk.permanent_loss"
    ],
    "required_fact_types": [
      "market.price",
      "capital_allocation.share_count",
      "valuation.downside_asset_value"
    ]
  },
  "components": {
    "calibration_cases": "evaluation/calibration_cases.jsonl",
    "counterfactuals": "counterfactuals.jsonl",
    "decision_cases": "decision_cases.jsonl",
    "decision_policy": "decision_policy.json",
    "doctrine": "doctrine.jsonl",
    "experiments": "evaluation/experiments.json",
    "failures": "failures.jsonl",
    "golden_cases": "evaluation/golden_cases.jsonl",
    "memory_policy": "memory_policy.json",
    "pairwise_cases": "evaluation/pairwise_cases.jsonl",
    "research_policy": "research_policy.json",
    "sources": "sources.jsonl",
    "tools": "tools.json"
  },
  "computation": {
    "dsl_version": "1.1",
    "pipeline": [
      "master_klarman.market_capitalisation",
      "master_klarman.downside_asset_coverage"
    ]
  },
  "decision": {
    "abstention_policy": "fail_closed",
    "common_projection": "common_stance_v1",
    "confidence_calibrator": null,
    "eligibility": [
      "market.price",
      "capital_allocation.share_count",
      "valuation.downside_asset_value"
    ],
    "hard_vetoes": [
      "master_klarman.no_reconstructable_downside",
      "master_klarman.senior_claims_consume_the_assets"
    ],
    "native_output": "capital_preservation_v1"
  },
  "evaluation": {
    "required_ablations": [
      "name",
      "voice",
      "policy",
      "evidence",
      "memory",
      "model"
    ]
  },
  "identity": {
    "maturity": "operator_lens",
    "operator_label": {
      "en": "Klarman Lens",
      "ja": "Klarman Lens・メソッドレンズ",
      "ko": "Klarman Lens 방법론 렌즈",
      "zh": "克拉曼视角"
    },
    "persona_id": "master_klarman",
    "public_label": {
      "en": "Klarman Lens Solo Test",
      "ja": "Klarman Lens 単独テスト",
      "ko": "Klarman Lens 단독 테스트",
      "zh": "克拉曼视角单人测试"
    },
    "source_cutoff": "2026-07-27"
  },
  "memory": {
    "belief_updates": "evidence_required",
    "episodic": false,
    "leak_rule": "public_at <= as_of AND memory_created_at <= as_of",
    "postmortem_horizon_days": 90
  },
  "pack_version": "0.9.4",
  "research": {
    "mandatory_disconfirming_queries": [
      "Decline when the conservative downside cannot be reconstructed.",
      "Reject when a plausible scenario causes unbounded permanent capital loss.",
      "Reject when catalyst timing and liquidity cannot support an absolute-return position."
    ],
    "planner": "solo_test_public_fact_planner_v1",
    "private_budget": {
      "fetches": 3,
      "queries": 3
    },
    "source_policy": "public_point_in_time_only_provisional_v1"
  },
  "schema_version": 3,
  "selection": {
    "best_for": {
      "en": "Capital preservation, distressed value, complex securities, and catalyst-driven value.",
      "ja": "資本保全、ディストレスト・バリュー、複雑証券、カタリスト主導の価値。",
      "ko": "자본 보전, 부실 자산 가치, 복합 증권, 촉매 중심 가치.",
      "zh": "资本保全、困境价值、复杂证券与催化剂驱动价值。"
    },
    "identity": {
      "en": "Klarman Lens; a provisional project-derived method lens, not the person's own words or current view",
      "ja": "Klarman Lens。プロジェクト派生の暫定メソッド視点であり、本人の発言や現在の見解ではない。",
      "ko": "Klarman Lens. 프로젝트에서 파생된 임시 방법론 관점이며, 본인의 발언이나 현재 견해가 아니다.",
      "zh": "克拉曼视角；项目派生的临时方法视角，非本人言论或当前观点"
    },
    "method": {
      "en": "Seek absolute return with capital preservation through downside asset protection, cash optionality, catalysts and conservative recovery analysis.",
      "ja": "下値を支える資産保護、現金の選択価値、カタリスト、保守的な回収分析を通じて、資本保全を伴う絶対収益を追求する。",
      "ko": "하방을 지지하는 자산 보호, 현금의 선택권 가치, 촉매, 보수적인 회수 분석을 통해 자본 보전을 동반한 절대수익을 추구한다.",
      "zh": "从现金期权、下行资产保护、催化剂和困境回收率评估绝对回报。"
