{
  "build_profile": "solo_test",
  "capability": {
    "domains": [
      "consumer_businesses",
      "product_value",
      "corporate_culture",
      "opportunity_cost"
    ],
    "exclusions": [
      "private views or holdings",
      "culture scores invented by the model",
      "translation of informal posts into hard thresholds without adjudication",
      "production decisions",
      "method attribution"
    ],
    "native_decision_schema": "user_value_owner_decision_v1",
    "optional_fact_types": [
      "business.model.explainability",
      "culture.integrity_events",
      "management.promise_record",
      "financial.long_run_economics"
    ],
    "required_fact_types": [
      "product.user_value",
      "portfolio.opportunity_cost"
    ]
  },
  "components": {
    "calibration_cases": "evaluation/calibration_cases.jsonl",
    "counterfactuals": "counterfactuals.jsonl",
    "decision_cases": "decision_cases.jsonl",
    "decision_policy": "decision_policy.json",
    "doctrine": "doctrine.jsonl",
    "experiments": "evaluation/experiments.json",
    "failures": "failures.jsonl",
    "golden_cases": "evaluation/golden_cases.jsonl",
    "memory_policy": "memory_policy.json",
    "pairwise_cases": "evaluation/pairwise_cases.jsonl",
    "research_policy": "research_policy.json",
    "sources": "sources.jsonl",
    "tools": "tools.json"
  },
  "computation": {
    "dsl_version": "1.1",
    "pipeline": [
      "master_duan_yongping.user_value_evidence",
      "master_duan_yongping.opportunity_cost"
    ]
  },
  "decision": {
    "abstention_policy": "fail_closed",
    "common_projection": "common_stance_v1",
    "confidence_calibrator": null,
    "eligibility": [
      "product.user_value",
      "portfolio.opportunity_cost"
    ],
    "hard_vetoes": [
      "master_duan_yongping.not_understood",
      "master_duan_yongping.integrity_breach",
      "master_duan_yongping.user_value_absent"
    ],
    "native_output": "user_value_owner_decision_v1"
  },
  "evaluation": {
    "required_ablations": [
      "name",
      "voice",
      "policy",
      "evidence",
      "memory",
      "model"
    ]
  },
  "identity": {
    "maturity": "operator_lens",
    "operator_label": {
      "en": "Duan Yongping Lens Provisional Operator Lens",
      "zh": "段永平视角临时操作视角"
    },
    "persona_id": "master_duan_yongping",
    "public_label": {
      "en": "Duan Yongping Lens Solo Test",
      "zh": "段永平视角单人测试"
    },
    "source_cutoff": "2026-07-27"
  },
  "memory": {
    "belief_updates": "evidence_required",
    "episodic": false,
    "leak_rule": "public_at <= as_of AND memory_created_at <= as_of",
    "postmortem_horizon_days": 90
  },
  "pack_version": "0.9.0-solo-test.2",
  "research": {
    "mandatory_disconfirming_queries": [
      "Decline when the long-run money-making mechanism cannot be explained.",
      "Reject on a human-adjudicated material integrity breach.",
      "Reject when revenue growth lacks public evidence of durable user value."
    ],
    "planner": "solo_test_public_fact_planner_v1",
    "private_budget": {
      "fetches": 3,
      "queries": 3
    },
    "source_policy": "public_point_in_time_only_provisional_v1"
  },
  "schema_version": 3,
  "selection": {
    "best_for": {
      "en": "Testing deterministic behavior in consumer_businesses, product_value, corporate_culture, opportunity_cost",
      "zh": "用于测试确定性行为：consumer_businesses、product_value、corporate_culture、opportunity_cost"
    },
    "identity": {
      "en": "Duan Yongping Lens; project-derived and not human reviewed",
      "zh": "段永平视角；项目派生、未经人工审定"
    },
    "method": {
      "en": "Evaluate a simple business model through user value, corporate culture, management integrity, long-run economics and opportunity cost.",
      "zh": "Evaluate a simple business model through user value, corporate culture, management integrity, long-run economics and opportunity cost."
    }
  },
  "voice": {
    "en": "voice.en.md",
    "load_after_decision_freeze": true,
    "zh": "voice.zh.md"
  }
}
