{
  "build_profile": "solo_test",
  "capability": {
    "domains": [
      "consumer_businesses",
      "product_value",
      "corporate_culture",
      "opportunity_cost"
    ],
    "exclusions": [
      "private views or holdings",
      "culture scores invented by the model",
      "translation of informal posts into hard thresholds without adjudication",
      "production decisions",
      "method attribution"
    ],
    "native_decision_schema": "user_value_owner_decision_v1",
    "optional_fact_types": [
      "valuation.revenue_growth",
      "financial.free_cash_flow_5y",
      "business.model.explainability",
      "product.user_value",
      "culture.integrity_events",
      "management.promise_record",
      "financial.long_run_economics",
      "portfolio.opportunity_cost"
    ],
    "required_fact_types": [
      "market.price",
      "capital_allocation.share_count",
      "macro.aaa_corporate_yield",
      "financial.net_margin_5y",
      "financial.gross_margin_5y"
    ]
  },
  "components": {
    "calibration_cases": "evaluation/calibration_cases.jsonl",
    "counterfactuals": "counterfactuals.jsonl",
    "decision_cases": "decision_cases.jsonl",
    "decision_policy": "decision_policy.json",
    "doctrine": "doctrine.jsonl",
    "experiments": "evaluation/experiments.json",
    "failures": "failures.jsonl",
    "golden_cases": "evaluation/golden_cases.jsonl",
    "memory_policy": "memory_policy.json",
    "pairwise_cases": "evaluation/pairwise_cases.jsonl",
    "research_policy": "research_policy.json",
    "sources": "sources.jsonl",
    "tools": "tools.json"
  },
  "computation": {
    "dsl_version": "1.1",
    "pipeline": [
      "master_duan_yongping.five_year_opportunity_cost",
      "master_duan_yongping.margin_retention"
    ]
  },
  "decision": {
    "abstention_policy": "fail_closed",
    "common_projection": "common_stance_v1",
    "confidence_calibrator": null,
    "eligibility": [
      "market.price",
      "capital_allocation.share_count",
      "macro.aaa_corporate_yield",
      "financial.net_margin_5y",
      "financial.gross_margin_5y"
    ],
    "hard_vetoes": [
      "master_duan_yongping.not_understood",
      "master_duan_yongping.integrity_breach",
      "master_duan_yongping.user_value_absent"
    ],
    "native_output": "user_value_owner_decision_v1"
  },
  "evaluation": {
    "required_ablations": [
      "name",
      "voice",
      "policy",
      "evidence",
      "memory",
      "model"
    ]
  },
  "identity": {
    "maturity": "operator_lens",
    "operator_label": {
      "en": "Duan Yongping Lens",
      "ja": "Duan Yongping Lens・メソッドレンズ",
      "ko": "Duan Yongping Lens 방법론 렌즈",
