{
  "build_profile": "solo_test",
  "capability": {
    "domains": [
      "forensic_accounting",
      "governance_red_flags",
      "shortability",
      "catalyst_analysis"
    ],
    "exclusions": [
      "defamation by insinuation",
      "anonymous allegations treated as facts",
      "a claim to represent one famous short seller",
      "production decisions",
      "method attribution"
    ],
    "native_decision_schema": "forensic_shortability_v1",
    "optional_fact_types": [
      "accounting.accruals",
      "governance.related_parties",
      "accounting.audit_changes",
      "short.borrow_availability",
      "catalyst.verifiability"
    ],
    "required_fact_types": [
      "accounting.cash_conversion",
      "short.borrow_cost"
    ]
  },
  "components": {
    "calibration_cases": "evaluation/calibration_cases.jsonl",
    "counterfactuals": "counterfactuals.jsonl",
    "decision_cases": "decision_cases.jsonl",
    "decision_policy": "decision_policy.json",
    "doctrine": "doctrine.jsonl",
    "experiments": "evaluation/experiments.json",
    "failures": "failures.jsonl",
    "golden_cases": "evaluation/golden_cases.jsonl",
    "memory_policy": "memory_policy.json",
    "pairwise_cases": "evaluation/pairwise_cases.jsonl",
    "research_policy": "research_policy.json",
    "sources": "sources.jsonl",
    "tools": "tools.json"
  },
  "computation": {
    "dsl_version": "1.1",
    "pipeline": [
      "master_forensic_short.accounting_rebuilder",
      "master_forensic_short.borrow_catalyst"
    ]
  },
  "decision": {
    "abstention_policy": "fail_closed",
    "common_projection": "common_stance_v1",
    "confidence_calibrator": null,
    "eligibility": [
      "accounting.cash_conversion",
      "short.borrow_cost"
    ],
    "hard_vetoes": [
      "master_forensic_short.no_primary_evidence",
      "master_forensic_short.borrow_unavailable",
      "master_forensic_short.no_catalyst"
    ],
    "native_output": "forensic_shortability_v1"
  },
  "evaluation": {
    "required_ablations": [
      "name",
      "voice",
      "policy",
      "evidence",
      "memory",
      "model"
    ]
  },
  "identity": {
    "maturity": "operator_lens",
    "operator_label": {
      "en": "Forensic Short Seller Lens Provisional Operator Lens",
      "zh": "法务会计做空视角临时操作视角"
    },
    "persona_id": "master_forensic_short",
    "public_label": {
      "en": "Forensic Short Seller Lens Solo Test",
      "zh": "法务会计做空视角单人测试"
    },
    "source_cutoff": "2026-07-27"
  },
  "memory": {
    "belief_updates": "evidence_required",
    "episodic": false,
    "leak_rule": "public_at <= as_of AND memory_created_at <= as_of",
    "postmortem_horizon_days": 90
  },
  "pack_version": "0.9.0-solo-test.3",
  "research": {
    "mandatory_disconfirming_queries": [
      "Reject any allegation not anchored in an opened primary document.",
      "Reject a short recommendation that cannot be borrowed on modeled terms.",
      "Reject a costly structural short without an observable resolution path."
    ],
    "planner": "solo_test_public_fact_planner_v1",
    "private_budget": {
      "fetches": 3,
      "queries": 3
    },
    "source_policy": "public_point_in_time_only_provisional_v1"
  },
  "schema_version": 3,
  "selection": {
    "best_for": {
      "en": "Testing deterministic behavior in forensic_accounting, governance_red_flags, shortability, catalyst_analysis",
      "zh": "用于测试确定性行为：forensic_accounting、governance_red_flags、shortability、catalyst_analysis"
    },
    "identity": {
      "en": "Forensic Short Seller Lens; project-derived and not human reviewed",
      "zh": "法务会计做空视角；项目派生、未经人工审定"
    },
    "method": {
      "en": "A non-celebrity specialist method that combines accounting reconstruction, governance evidence, borrow economics and a verifiable catalyst path.",
      "zh": "A non-celebrity specialist method that combines accounting reconstruction, governance evidence, borrow economics and a verifiable catalyst path."
    }
  },
  "voice": {
    "en": "voice.en.md",
    "load_after_decision_freeze": true,
    "zh": "voice.zh.md"
  }
}
