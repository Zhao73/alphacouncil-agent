      "market.price",
      "capital_allocation.share_count",
      "valuation.downside_floor"
    ],
    "hard_vetoes": [
      "master_pabrai.no_downside_floor",
      "master_pabrai.financing_fails_before_resolution"
    ],
    "native_output": "dhandho_payoff_v1"
  },
  "evaluation": {
    "required_ablations": [
      "name",
      "voice",
      "policy",
      "evidence",
      "memory",
      "model"
