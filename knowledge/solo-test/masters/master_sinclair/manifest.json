{
  "build_profile": "solo_test",
  "capability": {
    "domains": [
      "volatility_forecasting",
      "options_execution",
      "edge_measurement",
      "position_sizing"
    ],
    "exclusions": [
      "private trading strategies",
      "gross volatility spread called edge",
      "backtests without point-in-time and cost controls",
      "production decisions",
      "method attribution"
    ],
    "native_decision_schema": "volatility_edge_v1",
    "optional_fact_types": [
      "options.implied_volatility",
      "options.volatility_risk_premium",
      "execution.bid_ask",
      "execution.slippage",
      "risk.forecast_error",
      "position.fraction"
    ],
    "required_fact_types": [
      "options.realized_volatility_forecast"
    ]
  },
  "components": {
    "calibration_cases": "evaluation/calibration_cases.jsonl",
    "counterfactuals": "counterfactuals.jsonl",
    "decision_cases": "decision_cases.jsonl",
    "decision_policy": "decision_policy.json",
    "doctrine": "doctrine.jsonl",
    "experiments": "evaluation/experiments.json",
    "failures": "failures.jsonl",
    "golden_cases": "evaluation/golden_cases.jsonl",
    "memory_policy": "memory_policy.json",
    "pairwise_cases": "evaluation/pairwise_cases.jsonl",
    "research_policy": "research_policy.json",
    "sources": "sources.jsonl",
    "tools": "tools.json"
  },
  "computation": {
    "dsl_version": "1.1",
    "pipeline": [
      "master_sinclair.realized_vol_forecast",
      "master_sinclair.net_edge_sizer"
    ]
  },
  "decision": {
    "abstention_policy": "fail_closed",
    "common_projection": "common_stance_v1",
    "confidence_calibrator": null,
    "eligibility": [
      "options.realized_volatility_forecast"
    ],
    "hard_vetoes": [
      "master_sinclair.no_oos_forecast",
      "master_sinclair.cost_erasure",
      "master_sinclair.error_dominates"
    ],
    "native_output": "volatility_edge_v1"
  },
  "evaluation": {
    "required_ablations": [
      "name",
      "voice",
      "policy",
      "evidence",
      "memory",
      "model"
    ]
  },
  "identity": {
    "maturity": "operator_lens",
    "operator_label": {
      "en": "Sinclair Lens (Volatility Trading and Execution) Provisional Operator Lens",
      "zh": "辛克莱视角（波动率交易与执行）临时操作视角"
    },
    "persona_id": "master_sinclair",
    "public_label": {
      "en": "Sinclair Lens (Volatility Trading and Execution) Solo Test",
      "zh": "辛克莱视角（波动率交易与执行）单人测试"
    },
    "source_cutoff": "2026-07-27"
  },
  "memory": {
    "belief_updates": "evidence_required",
    "episodic": false,
    "leak_rule": "public_at <= as_of AND memory_created_at <= as_of",
    "postmortem_horizon_days": 90
  },
  "pack_version": "0.9.0-solo-test.1",
  "research": {
    "mandatory_disconfirming_queries": [
      "Reject an edge based on an unvalidated realized-volatility forecast.",
      "Reject when spread and slippage erase the gross volatility difference.",
      "Reject when forecast error is material relative to estimated net edge."
    ],
    "planner": "solo_test_public_fact_planner_v1",
    "private_budget": {
      "fetches": 3,
      "queries": 3
    },
    "source_policy": "public_point_in_time_only_provisional_v1"
  },
  "schema_version": 3,
  "selection": {
    "best_for": {
      "en": "Testing deterministic behavior in volatility_forecasting, options_execution, edge_measurement, position_sizing",
      "zh": "用于测试确定性行为：volatility_forecasting、options_execution、edge_measurement、position_sizing"
    },
    "identity": {
      "en": "Sinclair Lens (Volatility Trading and Execution); project-derived and not human reviewed",
      "zh": "辛克莱视角（波动率交易与执行）；项目派生、未经人工审定"
    },
    "method": {
      "en": "Forecast realized volatility, compare it with implied volatility, subtract spreads and slippage, and size only a robust executable edge.",
      "zh": "Forecast realized volatility, compare it with implied volatility, subtract spreads and slippage, and size only a robust executable edge."
    }
  },
  "voice": {
    "en": "voice.en.md",
    "load_after_decision_freeze": true,
    "zh": "voice.zh.md"
  }
}
