{
  "build_profile": "solo_test",
  "capability": {
    "domains": [
      "factor_investing",
      "portfolio_attribution",
      "style_cycles",
      "crowding"
    ],
    "exclusions": [
      "AQR proprietary live models",
      "factor definitions without versioned formulas",
      "calling residual noise manager skill",
      "production decisions",
      "method attribution"
    ],
    "native_decision_schema": "factor_adjusted_alpha_v1",
    "optional_fact_types": [
      "market.change_pct",
      "macro.credit_spread",
      "factor.value_exposure",
      "factor.momentum_exposure",
      "factor.quality_exposure",
      "factor.beta_exposure",
      "factor.sector_exposure",
      "factor.crowding",
      "return.factor_adjusted"
    ],
    "required_fact_types": [
      "index.aggregate_earnings_yield",
      "macro.real_rate",
      "macro.long_bond_yield"
    ]
  },
  "components": {
    "calibration_cases": "evaluation/calibration_cases.jsonl",
    "counterfactuals": "counterfactuals.jsonl",
    "decision_cases": "decision_cases.jsonl",
    "decision_policy": "decision_policy.json",
    "doctrine": "doctrine.jsonl",
    "experiments": "evaluation/experiments.json",
    "failures": "failures.jsonl",
    "golden_cases": "evaluation/golden_cases.jsonl",
    "memory_policy": "memory_policy.json",
    "pairwise_cases": "evaluation/pairwise_cases.jsonl",
    "research_policy": "research_policy.json",
    "sources": "sources.jsonl",
    "tools": "tools.json"
  },
  "computation": {
    "dsl_version": "1.1",
    "pipeline": [
      "master_asness.real_earnings_yield_gap",
      "master_asness.nominal_earnings_yield_gap"
    ]
  },
  "decision": {
    "abstention_policy": "fail_closed",
    "common_projection": "common_stance_v1",
    "confidence_calibrator": null,
    "eligibility": [
      "index.aggregate_earnings_yield",
      "macro.real_rate",
      "macro.long_bond_yield"
    ],
    "hard_vetoes": [
      "master_asness.fed_model_illusion"
    ],
    "native_output": "factor_adjusted_alpha_v1"
  },
  "evaluation": {
    "required_ablations": [
      "name",
      "voice",
      "policy",
      "evidence",
      "memory",
      "model"
    ]
  },
  "identity": {
    "maturity": "operator_lens",
    "operator_label": {
      "en": "Asness Factor Lens",
      "ja": "Asness Factor Lens・メソッドレンズ",
      "ko": "Asness Factor Lens 방법론 렌즈",
      "zh": "Asness 因子视角"
    },
    "persona_id": "master_asness",
    "public_label": {
      "en": "Asness Factor Lens Solo Test",
      "ja": "Asness Factor Lens 単独テスト",
      "ko": "Asness Factor Lens 단독 테스트",
      "zh": "Asness 因子视角单人测试"
    },
    "source_cutoff": "2026-07-27"
  },
  "memory": {
    "belief_updates": "evidence_required",
    "episodic": false,
    "leak_rule": "public_at <= as_of AND memory_created_at <= as_of",
    "postmortem_horizon_days": 90
  },
  "pack_version": "0.9.4",
  "research": {
    "mandatory_disconfirming_queries": [
      "Reject attribution when factor construction is not versioned and reproducible.",
      "Reject an alpha claim fully explained by cheap systematic exposures.",
      "Reject an implementable-edge claim erased by crowding and costs."
    ],
    "planner": "solo_test_public_fact_planner_v1",
    "private_budget": {
      "fetches": 3,
      "queries": 3
    },
    "source_policy": "public_point_in_time_only_provisional_v1"
  },
  "schema_version": 3,
  "selection": {
    "best_for": {
      "en": "Factor investing, portfolio attribution, style cycles, and crowded positioning.",
      "ja": "ファクター投資、ポートフォリオ帰属分析、スタイル循環、ポジションの混雑。",
      "ko": "팩터 투자, 포트폴리오 성과 귀속, 스타일 순환, 포지션 쏠림.",
      "zh": "因子投资、组合归因、风格周期与拥挤交易。"
    },
    "identity": {
      "en": "Asness Factor Lens; a provisional project-derived method lens, not the person's own words or current view",
      "ja": "Asness Factor Lens。プロジェクト派生の暫定メソッド視点であり、本人の発言や現在の見解ではない。",
      "ko": "Asness Factor Lens. 프로젝트에서 파생된 임시 방법론 관점이며, 본인의 발언이나 현재 견해가 아니다.",
      "zh": "Asness 因子视角；项目派生的临时方法视角，非本人言论或当前观点"
    },
    "method": {
      "en": "Decompose returns into value, momentum, quality, beta, sector and crowding exposures before treating residual performance as alpha.",
      "ja": "リターンをバリュー、モメンタム、クオリティ、ベータ、セクター、混雑度へのエクスポージャーに分解し、残差リターンをアルファとみなす前に検証する。",
      "ko": "수익률을 가치, 모멘텀, 퀄리티, 베타, 섹터, 쏠림 노출로 분해한 뒤 잔여 성과를 알파로 간주할 수 있는지 검증한다.",
      "zh": "分解价值、动量、质量、beta、行业暴露和拥挤度，检查所谓 alpha 是否只是因子。"
    }
