{
  "build_profile": "solo_test",
  "capability": {
    "domains": [
      "long_duration_quality",
      "management_integrity",
      "structural_growth",
      "capital_preservation"
    ],
    "exclusions": [
      "Himalaya private portfolio reasoning",
      "holdings treated as proof of motive",
      "binary integrity labels without reviewed evidence",
      "production decisions",
      "method attribution"
    ],
    "native_decision_schema": "ten_year_certainty_decision_v1",
    "optional_fact_types": [
      "industry.structural_direction",
      "governance.integrity_events",
      "capital_allocation.history",
      "valuation.long_run_return"
    ],
    "required_fact_types": [
      "management.promise_record",
      "business.ten_year_durability"
    ]
  },
  "components": {
    "calibration_cases": "evaluation/calibration_cases.jsonl",
    "counterfactuals": "counterfactuals.jsonl",
    "decision_cases": "decision_cases.jsonl",
    "decision_policy": "decision_policy.json",
    "doctrine": "doctrine.jsonl",
    "experiments": "evaluation/experiments.json",
    "failures": "failures.jsonl",
    "golden_cases": "evaluation/golden_cases.jsonl",
    "memory_policy": "memory_policy.json",
    "pairwise_cases": "evaluation/pairwise_cases.jsonl",
    "research_policy": "research_policy.json",
    "sources": "sources.jsonl",
    "tools": "tools.json"
  },
  "computation": {
    "dsl_version": "1.1",
