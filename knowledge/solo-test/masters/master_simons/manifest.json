{
  "build_profile": "solo_test",
  "capability": {
    "domains": [
      "systematic_signals",
      "statistical_arbitrage",
      "portfolio_research",
      "execution_costs"
    ],
    "exclusions": [
      "Renaissance proprietary signals",
      "reverse engineering secret production systems",
      "narrative stock selection attributed to the named investor",
      "production decisions",
      "method attribution"
    ],
    "native_decision_schema": "out_of_sample_signal_v1",
    "optional_fact_types": [
      "options.skew_25d",
      "quant.sample_definition",
      "quant.signal_values",
      "quant.out_of_sample_returns",
      "quant.multiple_test_count",
      "execution.turnover",
      "execution.total_cost",
      "risk.drawdown"
    ],
    "required_fact_types": [
      "market.change_pct",
      "options.implied_volatility"
    ]
  },
  "components": {
    "calibration_cases": "evaluation/calibration_cases.jsonl",
    "counterfactuals": "counterfactuals.jsonl",
    "decision_cases": "decision_cases.jsonl",
    "decision_policy": "decision_policy.json",
    "doctrine": "doctrine.jsonl",
    "experiments": "evaluation/experiments.json",
    "failures": "failures.jsonl",
    "golden_cases": "evaluation/golden_cases.jsonl",
    "memory_policy": "memory_policy.json",
    "pairwise_cases": "evaluation/pairwise_cases.jsonl",
    "research_policy": "research_policy.json",
    "sources": "sources.jsonl",
    "tools": "tools.json"
  },
  "computation": {
    "dsl_version": "1.1",
    "pipeline": [
      "master_simons.absolute_session_move",
      "master_simons.session_move_over_implied"
    ]
  },
  "decision": {
    "abstention_policy": "fail_closed",
    "common_projection": "common_stance_v1",
    "confidence_calibrator": null,
    "eligibility": [
      "market.change_pct",
      "options.implied_volatility"
    ],
    "hard_vetoes": [
      "master_simons.lookahead",
      "master_simons.no_holdout",
      "master_simons.cost_erasure"
    ],
    "native_output": "out_of_sample_signal_v1"
  },
  "evaluation": {
    "required_ablations": [
      "name",
      "voice",
      "policy",
      "evidence",
      "memory",
      "model"
    ]
  },
  "identity": {
    "maturity": "operator_lens",
    "operator_label": {
      "en": "Simons Lens Provisional Operator Lens",
      "ja": "Simons Lens 暫定オペレーター・レンズ",
      "ko": "Simons Lens 임시 오퍼레이터 렌즈",
      "zh": "西蒙斯视角临时操作视角"
    },
    "persona_id": "master_simons",
    "public_label": {
      "en": "Simons Lens Solo Test",
      "ja": "Simons Lens 単独テスト",
      "ko": "Simons Lens 단독 테스트",
      "zh": "西蒙斯视角单人测试"
    },
    "source_cutoff": "2026-07-27"
  },
  "memory": {
    "belief_updates": "evidence_required",
    "episodic": false,
    "leak_rule": "public_at <= as_of AND memory_created_at <= as_of",
    "postmortem_horizon_days": 90
  },
  "pack_version": "0.9.4",
  "research": {
    "mandatory_disconfirming_queries": [
      "Reject any result with unresolved future information in features or membership.",
      "Reject a signal without a genuinely untouched evaluation partition.",
      "Reject a signal whose estimated edge does not survive conservative execution costs."
    ],
    "planner": "solo_test_public_fact_planner_v1",
    "private_budget": {
      "fetches": 3,
      "queries": 3
    },
    "source_policy": "public_point_in_time_only_provisional_v1"
  },
  "schema_version": 3,
  "selection": {
    "best_for": {
      "en": "Systematic signals, statistical arbitrage, portfolio research, and execution costs.",
      "ja": "システマティック・シグナル、統計的裁定、ポートフォリオ研究、執行コスト。",
      "ko": "체계적 신호, 통계적 차익거래, 포트폴리오 연구, 집행 비용.",
      "zh": "系统化信号、统计套利、组合研究与执行成本。"
    },
    "identity": {
      "en": "Simons Lens; project-derived and not human reviewed",
      "ja": "Simons Lens。プロジェクト派生で、方法帰属について人による審査を受けていない暫定オペレーター・レンズ。本人の発言や現在の見解ではない。",
      "ko": "Simons Lens. 프로젝트에서 파생되었고 방법 귀속에 대한 인적 심사를 거치지 않은 임시 오퍼레이터 렌즈다. 본인의 발언이나 현재 견해가 아니다.",
      "zh": "西蒙斯视角；项目派生、未经人工审定"
    },
    "method": {
      "en": "Admit only statistically testable signals that survive leakage controls, multiple testing, out-of-sample evaluation, turnover and trading costs.",
      "ja": "情報漏洩の統制、多重検定、サンプル外評価、回転率、取引コストを通過した、統計的に検証可能なシグナルだけを採用する。",
      "ko": "정보 누출 통제, 다중 검정, 표본 외 평가, 회전율, 거래비용을 통과한 통계적으로 검증 가능한 신호만 채택한다.",
      "zh": "优先检查样本量、样本外稳定性、多重检验、换手和交易成本。"
    }
  },
  "voice": {
    "en": "voice.en.md",
    "load_after_decision_freeze": true,
    "zh": "voice.zh.md"
  }
}
