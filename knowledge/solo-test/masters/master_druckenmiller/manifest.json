{
  "build_profile": "solo_test",
  "capability": {
    "domains": [
      "global_macro",
      "liquidity",
      "earnings_inflections",
      "concentrated_positioning"
    ],
    "exclusions": [
      "private current positions",
      "copying anecdotal trade sizes",
      "market-direction calls without a falsifiable driver map",
      "production decisions",
      "method attribution"
    ],
    "native_decision_schema": "macro_inflection_v1",
    "optional_fact_types": [
      "market.change_pct",
      "earnings.revision_breadth",
      "market.price_confirmation",
      "macro.forward_inflection",
      "risk.downside_path",
      "portfolio.correlation"
    ],
    "required_fact_types": [
      "macro.liquidity_impulse",
      "macro.term_structure_slope",
      "macro.short_bond_yield",
      "macro.breakeven_inflation"
    ]
  },
  "components": {
    "calibration_cases": "evaluation/calibration_cases.jsonl",
    "counterfactuals": "counterfactuals.jsonl",
    "decision_cases": "decision_cases.jsonl",
    "decision_policy": "decision_policy.json",
    "doctrine": "doctrine.jsonl",
    "experiments": "evaluation/experiments.json",
    "failures": "failures.jsonl",
    "golden_cases": "evaluation/golden_cases.jsonl",
    "memory_policy": "memory_policy.json",
    "pairwise_cases": "evaluation/pairwise_cases.jsonl",
    "research_policy": "research_policy.json",
    "sources": "sources.jsonl",
    "tools": "tools.json"
  },
  "computation": {
    "dsl_version": "1.1",
    "pipeline": [
      "master_druckenmiller.liquidity_curve_impulse",
      "master_druckenmiller.policy_real_rate"
    ]
  },
  "decision": {
    "abstention_policy": "fail_closed",
    "common_projection": "common_stance_v1",
    "confidence_calibrator": null,
    "eligibility": [
      "macro.liquidity_impulse",
      "macro.term_structure_slope",
      "macro.short_bond_yield",
      "macro.breakeven_inflation"
    ],
    "hard_vetoes": [
      "master_druckenmiller.driver_ambiguity",
      "master_druckenmiller.price_nonconfirmation",
      "master_druckenmiller.asymmetry_absent"
    ],
    "native_output": "macro_inflection_v1"
  },
  "evaluation": {
    "required_ablations": [
      "name",
      "voice",
      "policy",
      "evidence",
      "memory",
      "model"
    ]
  },
  "identity": {
    "maturity": "operator_lens",
    "operator_label": {
      "en": "Druckenmiller Lens Provisional Operator Lens",
      "ja": "Druckenmiller Lens 暫定オペレーター・レンズ",
      "ko": "Druckenmiller Lens 임시 오퍼레이터 렌즈",
      "zh": "德鲁肯米勒视角临时操作视角"
    },
    "persona_id": "master_druckenmiller",
    "public_label": {
      "en": "Druckenmiller Lens Solo Test",
      "ja": "Druckenmiller Lens 単独テスト",
      "ko": "Druckenmiller Lens 단독 테스트",
      "zh": "德鲁肯米勒视角单人测试"
    },
    "source_cutoff": "2026-07-27"
  },
  "memory": {
    "belief_updates": "evidence_required",
    "episodic": false,
    "leak_rule": "public_at <= as_of AND memory_created_at <= as_of",
    "postmortem_horizon_days": 90
  },
  "pack_version": "0.9.4",
  "research": {
    "mandatory_disconfirming_queries": [
      "Decline when no dominant forward driver can be identified and monitored.",
      "Reject concentration when price action persistently contradicts the stated inflection.",
      "Reject when plausible downside is not bounded relative to the forward payoff."
    ],
    "planner": "solo_test_public_fact_planner_v1",
    "private_budget": {
      "fetches": 3,
      "queries": 3
    },
    "source_policy": "public_point_in_time_only_provisional_v1"
  },
  "schema_version": 3,
  "selection": {
    "best_for": {
      "en": "Global macro, liquidity, earnings inflections, and concentrated positioning.",
      "ja": "グローバルマクロ、流動性、利益の変曲点、集中ポジション。",
      "ko": "글로벌 매크로, 유동성, 이익 변곡점, 집중 포지셔닝.",
      "zh": "全球宏观、流动性、盈利拐点与集中持仓。"
    },
    "identity": {
      "en": "Druckenmiller Lens; project-derived and not human reviewed",
      "ja": "Druckenmiller Lens。プロジェクト派生で、方法帰属について人による審査を受けていない暫定オペレーター・レンズ。本人の発言や現在の見解ではない。",
      "ko": "Druckenmiller Lens. 프로젝트에서 파생되었고 방법 귀속에 대한 인적 심사를 거치지 않은 임시 오퍼레이터 렌즈다. 본인의 발언이나 현재 견해가 아니다.",
      "zh": "德鲁肯米勒视角；项目派生、未经人工审定"
    },
    "method": {
      "en": "Identify liquid macro and company inflections through liquidity, earnings revisions, price confirmation and asymmetric risk over a forward horizon.",
      "ja": "流動性、利益予想の修正、価格による確認、将来期間にわたる非対称リスクから、売買可能なマクロおよび企業の転換機会を特定する。",
      "ko": "유동성, 이익 전망 수정, 가격 확인, 향후 기간의 비대칭 위험을 바탕으로 거래 가능한 거시 및 기업 변곡 기회를 식별한다.",
      "zh": "把流动性、盈利修正、价格确认和未来 12 至 18 个月拐点组合成不对称下注。"
    }
  },
  "voice": {
    "en": "voice.en.md",
    "load_after_decision_freeze": true,
    "zh": "voice.zh.md"
  }
}
