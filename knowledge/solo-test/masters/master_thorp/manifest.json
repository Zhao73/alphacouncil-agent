{
  "build_profile": "solo_test",
  "capability": {
    "domains": [
      "probabilistic_edge",
      "position_sizing",
      "arbitrage",
      "risk_of_ruin"
    ],
    "exclusions": [
      "proprietary historical trading rules",
      "full-Kelly prescriptions without uncertainty",
      "odds invented from narrative confidence",
      "production decisions",
      "method attribution"
    ],
    "native_decision_schema": "edge_sizing_v1",
    "optional_fact_types": [
      "trade.payoff_distribution",
      "trade.edge",
      "portfolio.dependence",
      "execution.liquidity",
      "position.fraction"
    ],
    "required_fact_types": [
      "probability.outcome_distribution",
      "risk.ruin_probability"
    ]
  },
  "components": {
    "calibration_cases": "evaluation/calibration_cases.jsonl",
    "counterfactuals": "counterfactuals.jsonl",
    "decision_cases": "decision_cases.jsonl",
    "decision_policy": "decision_policy.json",
    "doctrine": "doctrine.jsonl",
    "experiments": "evaluation/experiments.json",
    "failures": "failures.jsonl",
    "golden_cases": "evaluation/golden_cases.jsonl",
    "memory_policy": "memory_policy.json",
    "pairwise_cases": "evaluation/pairwise_cases.jsonl",
    "research_policy": "research_policy.json",
    "sources": "sources.jsonl",
    "tools": "tools.json"
  },
  "computation": {
    "dsl_version": "1.1",
    "pipeline": [
      "master_thorp.edge_recalculator",
      "master_thorp.fractional_kelly"
    ]
  },
  "decision": {
    "abstention_policy": "fail_closed",
    "common_projection": "common_stance_v1",
    "confidence_calibrator": null,
    "eligibility": [
      "probability.outcome_distribution",
      "risk.ruin_probability"
    ],
    "hard_vetoes": [
      "master_thorp.no_measurable_edge",
      "master_thorp.ruin_constraint",
      "master_thorp.liquidity_constraint"
    ],
    "native_output": "edge_sizing_v1"
  },
  "evaluation": {
    "required_ablations": [
      "name",
      "voice",
      "policy",
      "evidence",
      "memory",
      "model"
    ]
  },
  "identity": {
    "maturity": "operator_lens",
    "operator_label": {
      "en": "Thorp Lens Provisional Operator Lens",
      "zh": "索普视角临时操作视角"
    },
    "persona_id": "master_thorp",
    "public_label": {
      "en": "Thorp Lens Solo Test",
      "zh": "索普视角单人测试"
    },
    "source_cutoff": "2026-07-27"
  },
  "memory": {
    "belief_updates": "evidence_required",
    "episodic": false,
    "leak_rule": "public_at <= as_of AND memory_created_at <= as_of",
    "postmortem_horizon_days": 90
  },
  "pack_version": "0.9.3",
  "research": {
    "mandatory_disconfirming_queries": [
      "Reject when edge cannot be independently recomputed from explicit outcomes.",
      "Reject sizing that permits an absorbing loss under plausible dependence.",
      "Reject a theoretical size that cannot be entered and exited at modeled costs."
    ],
    "planner": "solo_test_public_fact_planner_v1",
    "private_budget": {
      "fetches": 3,
      "queries": 3
    },
    "source_policy": "public_point_in_time_only_provisional_v1"
  },
  "schema_version": 3,
  "selection": {
    "best_for": {
      "en": "Testing deterministic behavior in probabilistic_edge, position_sizing, arbitrage, risk_of_ruin",
      "zh": "用于测试确定性行为：probabilistic_edge、position_sizing、arbitrage、risk_of_ruin"
    },
    "identity": {
      "en": "Thorp Lens; project-derived and not human reviewed",
      "zh": "索普视角；项目派生、未经人工审定"
    },
    "method": {
      "en": "Independently estimate edge and odds, then constrain Kelly-style sizing by estimation error, dependence, liquidity and risk of ruin.",
      "zh": "Independently estimate edge and odds, then constrain Kelly-style sizing by estimation error, dependence, liquidity and risk of ruin."
    }
  },
  "voice": {
    "en": "voice.en.md",
    "load_after_decision_freeze": true,
    "zh": "voice.zh.md"
  }
}
