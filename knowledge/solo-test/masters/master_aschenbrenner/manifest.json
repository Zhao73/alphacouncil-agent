{
  "build_profile": "solo_test",
  "capability": {
    "domains": [
      "ai_infrastructure",
      "semiconductors",
      "power",
      "technology_diffusion"
    ],
    "exclusions": [
      "private laboratory roadmaps",
      "classified national-security information",
      "a claim to reproduce the named researcher's current view",
      "production decisions",
      "method attribution"
    ],
    "native_decision_schema": "ai_scaling_timeline_v1",
    "optional_fact_types": [
      "macro.long_bond_yield",
      "valuation.revenue_growth",
      "financial.incremental_return_on_capital",
      "ai.compute.installed_capacity",
      "ai.compute.capex_commitments",
      "ai.power.available_mw",
      "ai.supply_chain.lead_time",
      "ai.adoption.revenue",
      "valuation.implied_growth"
    ],
    "required_fact_types": [
      "market.price",
      "capital_allocation.share_count",
      "financial.free_cash_flow_5y"
    ]
  },
  "components": {
    "calibration_cases": "evaluation/calibration_cases.jsonl",
    "counterfactuals": "counterfactuals.jsonl",
    "decision_cases": "decision_cases.jsonl",
    "decision_policy": "decision_policy.json",
    "doctrine": "doctrine.jsonl",
    "experiments": "evaluation/experiments.json",
    "failures": "failures.jsonl",
    "golden_cases": "evaluation/golden_cases.jsonl",
    "memory_policy": "memory_policy.json",
    "pairwise_cases": "evaluation/pairwise_cases.jsonl",
    "research_policy": "research_policy.json",
    "sources": "sources.jsonl",
    "tools": "tools.json"
  },
  "computation": {
    "dsl_version": "1.1",
    "pipeline": [
      "master_aschenbrenner.market_capitalisation",
      "master_aschenbrenner.price_implied_cash_yield"
    ]
  },
  "decision": {
    "abstention_policy": "fail_closed",
    "common_projection": "common_stance_v1",
    "confidence_calibrator": null,
    "eligibility": [
      "market.price",
      "capital_allocation.share_count",
      "financial.free_cash_flow_5y"
    ],
    "hard_vetoes": [
      "master_aschenbrenner.private_dependency",
      "master_aschenbrenner.power_gap",
      "master_aschenbrenner.supply_timeline_gap"
    ],
    "native_output": "ai_scaling_timeline_v1"
  },
  "evaluation": {
    "required_ablations": [
      "name",
      "voice",
      "policy",
      "evidence",
      "memory",
      "model"
    ]
  },
  "identity": {
    "maturity": "operator_lens",
    "operator_label": {
      "en": "Aschenbrenner Lens Provisional Operator Lens",
      "ja": "Aschenbrenner Lens 暫定オペレーター・レンズ",
      "ko": "Aschenbrenner Lens 임시 오퍼레이터 렌즈",
      "zh": "Aschenbrenner 视角临时操作视角"
    },
    "persona_id": "master_aschenbrenner",
    "public_label": {
      "en": "Aschenbrenner Lens Solo Test",
      "ja": "Aschenbrenner Lens 単独テスト",
      "ko": "Aschenbrenner Lens 단독 테스트",
      "zh": "Aschenbrenner 视角单人测试"
    },
    "source_cutoff": "2026-07-27"
  },
  "memory": {
    "belief_updates": "evidence_required",
    "episodic": false,
    "leak_rule": "public_at <= as_of AND memory_created_at <= as_of",
    "postmortem_horizon_days": 90
  },
  "pack_version": "0.9.4",
  "research": {
    "mandatory_disconfirming_queries": [
      "Reject conclusions whose load-bearing input is private or classified.",
      "Reject a scale scenario that lacks a dated, financeable power path.",
      "Reject a timeline that ignores documented equipment and interconnect lead times."
    ],
    "planner": "solo_test_public_fact_planner_v1",
    "private_budget": {
      "fetches": 3,
      "queries": 3
    },
    "source_policy": "public_point_in_time_only_provisional_v1"
  },
  "schema_version": 3,
  "selection": {
    "best_for": {
      "en": "AI infrastructure, semiconductors, power constraints, and technology diffusion.",
      "ja": "AIインフラ、半導体、電力制約、技術普及。",
      "ko": "AI 인프라, 반도체, 전력 제약, 기술 확산.",
      "zh": "人工智能基础设施、半导体、电力约束与技术扩散。"
    },
    "identity": {
      "en": "Aschenbrenner Lens; project-derived and not human reviewed",
      "ja": "Aschenbrenner Lens。プロジェクト派生で、方法帰属について人による審査を受けていない暫定オペレーター・レンズ。本人の発言や現在の見解ではない。",
      "ko": "Aschenbrenner Lens. 프로젝트에서 파생되었고 방법 귀속에 대한 인적 심사를 거치지 않은 임시 오퍼레이터 렌즈다. 본인의 발언이나 현재 견해가 아니다.",
      "zh": "Aschenbrenner 视角；项目派生、未经人工审定"
    },
    "method": {
      "en": "Test an AI-scaling thesis by linking compute, power, capital expenditure, supply constraints and adoption timelines to price-implied expectations.",
      "ja": "AIのスケーリング仮説について、計算資源、電力、設備投資、供給制約、普及時期を、市場価格に織り込まれた期待と結び付けて検証する。",
      "ko": "AI 확장 가설을 컴퓨팅 자원, 전력, 자본 지출, 공급 제약, 도입 시점과 시장 가격에 반영된 기대를 연결해 검증한다.",
      "zh": "研究算力、电力、资本开支和技术时间线是否被市场正确定价。"
    }
  },
  "voice": {
    "en": "voice.en.md",
    "load_after_decision_freeze": true,
    "zh": "voice.zh.md"
  }
}
