{
  "build_profile": "solo_test",
  "capability": {
    "domains": [
      "consumer_observation",
      "growth_categories",
      "cyclicals",
      "turnarounds",
      "asset_plays"
    ],
    "exclusions": [
      "using PEG identically across all company categories",
      "anecdotal product popularity without company economics",
      "Fidelity's private research process",
      "production decisions",
      "method attribution"
    ],
    "native_decision_schema": "category_story_decision_v1",
    "optional_fact_types": [
      "financial.growth_rate",
      "valuation.peg_contextual",
      "financial.inventory",
      "business.unit_expansion",
      "cycle.position"
    ],
    "required_fact_types": [
      "company.category",
      "business.two_minute_story"
    ]
  },
  "components": {
    "calibration_cases": "evaluation/calibration_cases.jsonl",
    "counterfactuals": "counterfactuals.jsonl",
    "decision_cases": "decision_cases.jsonl",
    "decision_policy": "decision_policy.json",
    "doctrine": "doctrine.jsonl",
    "experiments": "evaluation/experiments.json",
    "failures": "failures.jsonl",
    "golden_cases": "evaluation/golden_cases.jsonl",
    "memory_policy": "memory_policy.json",
    "pairwise_cases": "evaluation/pairwise_cases.jsonl",
    "research_policy": "research_policy.json",
    "sources": "sources.jsonl",
    "tools": "tools.json"
  },
  "computation": {
    "dsl_version": "1.1",
    "pipeline": [
      "master_lynch.category_classifier",
      "master_lynch.story_numbers_check"
    ]
  },
  "decision": {
    "abstention_policy": "fail_closed",
    "common_projection": "common_stance_v1",
    "confidence_calibrator": null,
    "eligibility": [
      "company.category",
      "business.two_minute_story"
    ],
    "hard_vetoes": [
      "master_lynch.category_error",
      "master_lynch.story_numbers_conflict",
      "master_lynch.inventory_or_balance_sheet"
    ],
    "native_output": "category_story_decision_v1"
  },
  "evaluation": {
    "required_ablations": [
      "name",
      "voice",
      "policy",
      "evidence",
      "memory",
      "model"
    ]
  },
  "identity": {
    "maturity": "operator_lens",
    "operator_label": {
      "en": "Peter Lynch Lens Provisional Operator Lens",
      "zh": "彼得·林奇视角临时操作视角"
    },
    "persona_id": "master_lynch",
    "public_label": {
      "en": "Peter Lynch Lens Solo Test",
      "zh": "彼得·林奇视角单人测试"
    },
    "source_cutoff": "2026-07-27"
  },
  "memory": {
    "belief_updates": "evidence_required",
    "episodic": false,
    "leak_rule": "public_at <= as_of AND memory_created_at <= as_of",
    "postmortem_horizon_days": 90
  },
  "pack_version": "0.9.1",
  "research": {
    "mandatory_disconfirming_queries": [
      "Decline when the company cannot be placed in a reviewed category.",
      "Reject when the operating facts contradict the concise investment story.",
      "Reject category opportunities with an adjudicated balance-sheet or inventory break."
    ],
    "planner": "solo_test_public_fact_planner_v1",
    "private_budget": {
      "fetches": 3,
      "queries": 3
    },
    "source_policy": "public_point_in_time_only_provisional_v1"
  },
  "schema_version": 3,
  "selection": {
    "best_for": {
      "en": "Testing deterministic behavior in consumer_observation, growth_categories, cyclicals, turnarounds, asset_plays",
      "zh": "用于测试确定性行为：consumer_observation、growth_categories、cyclicals、turnarounds、asset_plays"
    },
    "identity": {
      "en": "Peter Lynch Lens; project-derived and not human reviewed",
      "zh": "彼得·林奇视角；项目派生、未经人工审定"
    },
    "method": {
      "en": "Classify the company type first, test a concise evidence-backed story, then apply category-appropriate growth, balance-sheet and valuation checks.",
      "zh": "Classify the company type first, test a concise evidence-backed story, then apply category-appropriate growth, balance-sheet and valuation checks."
    }
  },
  "voice": {
    "en": "voice.en.md",
    "load_after_decision_freeze": true,
    "zh": "voice.zh.md"
  }
}
