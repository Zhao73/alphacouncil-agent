{
  "build_profile": "solo_test",
  "capability": {
    "domains": [
      "deep_value",
      "asset_backed_securities",
      "normalized_earnings",
      "distressed_equity"
    ],
    "exclusions": [
      "mechanical use of historical formulas without context",
      "claims about modern securities absent source support",
      "a fixed margin-of-safety percentage by editorial choice",
      "production decisions",
      "method attribution"
    ],
    "native_decision_schema": "margin_of_safety_v1",
    "optional_fact_types": [
      "financial.leverage",
      "financial.net_current_asset_value",
      "financial.interest_coverage",
      "macro.aaa_corporate_yield",
      "financial.tangible_book_value",
      "financial.normalized_earnings",
      "financial.balance_sheet_claims",
      "valuation.liquidation_range",
      "market.price_to_floor"
    ],
    "required_fact_types": [
      "market.price",
      "capital_allocation.share_count",
      "financial.free_cash_flow_5y"
    ]
  },
  "components": {
    "calibration_cases": "evaluation/calibration_cases.jsonl",
    "counterfactuals": "counterfactuals.jsonl",
    "decision_cases": "decision_cases.jsonl",
    "decision_policy": "decision_policy.json",
    "doctrine": "doctrine.jsonl",
    "experiments": "evaluation/experiments.json",
    "failures": "failures.jsonl",
    "golden_cases": "evaluation/golden_cases.jsonl",
    "memory_policy": "memory_policy.json",
    "pairwise_cases": "evaluation/pairwise_cases.jsonl",
    "research_policy": "research_policy.json",
    "sources": "sources.jsonl",
    "tools": "tools.json"
  },
  "computation": {
    "dsl_version": "1.1",
    "pipeline": [
      "master_graham.defensive_hurdle_base",
      "master_graham.half_normalised_earnings_yield"
    ]
  },
  "decision": {
    "abstention_policy": "fail_closed",
    "common_projection": "common_stance_v1",
    "confidence_calibrator": null,
    "eligibility": [
      "market.price",
      "capital_allocation.share_count",
      "financial.free_cash_flow_5y"
    ],
    "hard_vetoes": [
      "master_graham.no_asset_floor",
      "master_graham.fixed_charge_coverage_failure"
    ],
    "native_output": "margin_of_safety_v1"
  },
  "evaluation": {
    "required_ablations": [
      "name",
      "voice",
      "policy",
      "evidence",
      "memory",
      "model"
    ]
  },
  "identity": {
    "maturity": "operator_lens",
    "operator_label": {
      "en": "Graham Lens",
      "ja": "Graham Lens・メソッドレンズ",
      "ko": "Graham Lens 방법론 렌즈",
      "zh": "格雷厄姆视角"
    },
    "persona_id": "master_graham",
    "public_label": {
      "en": "Graham Lens Solo Test",
      "ja": "Graham Lens 単独テスト",
      "ko": "Graham Lens 단독 테스트",
      "zh": "格雷厄姆视角单人测试"
    },
    "source_cutoff": "2026-07-27"
  },
  "memory": {
    "belief_updates": "evidence_required",
    "episodic": false,
    "leak_rule": "public_at <= as_of AND memory_created_at <= as_of",
    "postmortem_horizon_days": 90
  },
  "pack_version": "0.9.4",
  "research": {
    "mandatory_disconfirming_queries": [
      "Decline when assets and senior claims cannot be independently reconstructed.",
      "Reject when price lacks a reviewed discount to the conservative floor.",
      "Reject a static bargain whose realizable floor is demonstrably shrinking."
    ],
    "planner": "solo_test_public_fact_planner_v1",
    "private_budget": {
      "fetches": 3,
      "queries": 3
    },
    "source_policy": "public_point_in_time_only_provisional_v1"
  },
  "schema_version": 3,
  "selection": {
    "best_for": {
      "en": "Deep value, asset-backed securities, normalized earnings, and distressed equities.",
      "ja": "ディープバリュー、資産裏付け証券、平準化利益、ディストレスト株式。",
      "ko": "딥 밸류, 자산 담보 증권, 정상화 이익, 부실 기업 주식.",
      "zh": "深度价值、资产支撑证券、正常化盈利与困境股权。"
    },
    "identity": {
      "en": "Graham Lens; a method model, not the person's own words",
      "ja": "Graham Lens。メソッドモデルであり、本人の発言や現在の見解ではない。",
      "ko": "Graham Lens. 방법론 모델이며, 본인의 발언이나 현재 견해가 아니다.",
      "zh": "格雷厄姆视角；方法模型，非本人言论"
    },
    "method": {
      "en": "Establish an asset or normalized-earnings floor and require a human-adjudicated margin of safety before taking equity risk.",
      "ja": "資産価値または平準化利益に基づく下限を設定し、株式リスクを取る前に、人による審査を経た安全余裕を求める。",
      "ko": "자산 가치 또는 정상화 이익에 기반한 하한을 설정하고, 주식 위험을 감수하기 전에 사람의 심사를 거친 안전마진을 요구한다.",
      "zh": "先计算资产和盈利下限，再要求价格留下足够安全边际。"
    }
  },
  "voice": {
    "en": "voice.en.md",
    "load_after_decision_freeze": true,
    "zh": "voice.zh.md"
  }
}
