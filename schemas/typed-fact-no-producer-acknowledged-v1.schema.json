{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Zhao73/alphacouncil-agent/schemas/typed-fact-no-producer-acknowledged-v1.schema.json",
  "title": "AlphaCouncil typed-fact no-producer acknowledgement v1",
  "type": "object",
  "required": ["schema_version", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "entries": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["fact_id", "master_ids", "critical", "reason_code", "note"],
        "additionalProperties": false,
        "properties": {
          "fact_id": { "type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$" },
          "master_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^master_[a-z0-9_]+$" }
          },
          "critical": { "const": true },
          "reason_code": {
            "enum": [
              "no_public_keyless_source",
              "requires_model_judgement",
              "requires_derivative_payoff_model"
            ]
          },
          "note": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    }
  }
}
