{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Zhao73/alphacouncil-agent/schemas/persona-v3-ga-package-artifact-v1.schema.json",
  "title": "Unsigned physical package metadata for PersonaPack v3 GA",
  "description": "Collector output only. External release evidence must bind this file before it can support GA.",
  "type": "object",
  "required": ["schema_version", "artifact_kind", "generated_at", "status", "release_id", "release_manifest_hash", "package", "catalog", "selection_receipt", "result_bindings", "artifact_hash", "attestations"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_kind": { "const": "persona_v3_ga_package_artifact" },
    "generated_at": { "type": "string", "format": "date-time" },
    "status": { "const": "passed" },
    "release_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "release_manifest_hash": { "$ref": "#/$defs/hash" },
    "package": {
      "type": "object",
      "required": ["name", "version", "package_json_file_hash", "tarball_path", "tarball_file_hash", "tarball_package_json_hash"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "package_json_file_hash": { "$ref": "#/$defs/hash" },
        "tarball_path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
        "tarball_file_hash": { "$ref": "#/$defs/hash" },
        "tarball_package_json_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "catalog": { "$ref": "#/$defs/catalog" },
    "selection_receipt": {
      "type": "object",
      "required": ["receipt_binding_hash"],
      "additionalProperties": false,
      "properties": { "receipt_binding_hash": { "$ref": "#/$defs/hash" } }
    },
    "result_bindings": { "$ref": "#/$defs/resultBindings" },
    "artifact_hash": { "$ref": "#/$defs/hash" },
    "attestations": { "type": "array", "maxItems": 0 }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "catalog": {
      "type": "object",
      "required": ["catalog_hash", "catalog_order_hash", "selected_master_ids", "selected_pack_hashes"],
      "additionalProperties": false,
      "properties": {
        "catalog_hash": { "$ref": "#/$defs/hash" },
        "catalog_order_hash": { "$ref": "#/$defs/hash" },
        "selected_master_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "selected_pack_hashes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/hash" } }
      }
    },
    "resultBindings": {
      "type": "object",
      "required": ["fact_artifact", "deterministic_decision", "report", "report_quality"],
      "additionalProperties": false,
      "properties": {
        "fact_artifact": { "$ref": "#/$defs/resultBinding" },
        "deterministic_decision": { "$ref": "#/$defs/resultBinding" },
        "report": { "$ref": "#/$defs/resultBinding" },
        "report_quality": { "$ref": "#/$defs/resultBinding" }
      }
    },
    "resultBinding": {
      "type": "object",
      "required": ["relative_path", "file_hash"],
      "additionalProperties": false,
      "properties": {
        "relative_path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$" },
        "file_hash": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
