{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Zhao73/alphacouncil-agent/schemas/persona-v3-ai-semantic-source-adjudication-v1.schema.json",
  "title": "AlphaCouncil round-3 AI semantic source adjudication",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_kind", "pipeline_id", "review_stage", "reviewer_kind", "role", "role_id", "prompt_identity", "model_identity", "reviewed_on", "human_reviewed", "method_attribution_approved", "production_effect", "persona_id", "candidate_id", "source_binding", "extractor_binding", "skeptic_binding", "binding_checks", "proposition_adjudications", "final_overall_verdict", "agreements", "disagreements", "unresolved_questions", "final_rationale", "artifact_hash"],
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_kind": { "const": "persona_v3_ai_semantic_source_adjudication" },
    "pipeline_id": { "const": "alphacouncil_ai_semantic_source_adjudicator_v1" },
    "review_stage": { "const": "round_3_semantic_adjudication" },
    "reviewer_kind": { "const": "ai" },
    "role": { "const": "adjudicator" },
    "role_id": { "const": "ai_semantic_source_adjudicator_v1" },
    "prompt_identity": { "$ref": "#/$defs/prompt_identity" },
    "model_identity": { "type": "object", "additionalProperties": { "type": "string" }, "required": ["provider", "product", "model_family", "exact_deployment_id", "agent_task_id"] },
    "reviewed_on": { "type": "string", "format": "date" },
    "human_reviewed": { "const": false },
    "method_attribution_approved": { "const": false },
    "production_effect": { "const": "none" },
    "persona_id": { "type": "string", "pattern": "^master_[a-z0-9_]+$" },
    "candidate_id": { "type": "string", "minLength": 3 },
    "source_binding": { "$ref": "#/$defs/source_binding" },
    "extractor_binding": { "$ref": "#/$defs/prior_binding" },
    "skeptic_binding": { "$ref": "#/$defs/prior_binding" },
    "binding_checks": { "type": "object", "additionalProperties": false, "required": ["candidate_persona", "raw_bytes", "source_record", "extracted_text", "extractor_artifact", "skeptic_artifact"], "properties": { "candidate_persona": { "$ref": "#/$defs/check" }, "raw_bytes": { "$ref": "#/$defs/check" }, "source_record": { "$ref": "#/$defs/check" }, "extracted_text": { "$ref": "#/$defs/check" }, "extractor_artifact": { "$ref": "#/$defs/check" }, "skeptic_artifact": { "$ref": "#/$defs/check" } } },
    "proposition_adjudications": { "type": "array", "items": { "$ref": "#/$defs/proposition" } },
    "final_overall_verdict": { "$ref": "#/$defs/verdict" },
    "agreements": { "$ref": "#/$defs/strings" },
    "disagreements": { "$ref": "#/$defs/strings" },
    "unresolved_questions": { "$ref": "#/$defs/unresolved" },
    "final_rationale": { "type": "string", "minLength": 1 },
    "artifact_hash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "verdict": { "enum": ["supported", "partial", "unsupported", "unverifiable"] },
    "strings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "prompt_identity": { "type": "object", "additionalProperties": false, "required": ["prompt_id", "prompt_hash"], "properties": { "prompt_id": { "const": "alphacouncil.source-semantic-adjudicator.round3.v1" }, "prompt_hash": { "$ref": "#/$defs/hash" } } },
    "check": { "type": "object", "additionalProperties": false, "required": ["status", "detail"], "properties": { "status": { "const": "pass" }, "detail": { "type": "string", "minLength": 1 } } },
    "prior_binding": { "type": "object", "additionalProperties": false, "required": ["relative_path", "declared_artifact_hash", "recomputed_artifact_hash", "artifact_content_hash"], "properties": { "relative_path": { "type": "string", "minLength": 1 }, "declared_artifact_hash": { "$ref": "#/$defs/hash" }, "recomputed_artifact_hash": { "$ref": "#/$defs/hash" }, "artifact_content_hash": { "$ref": "#/$defs/hash" } } },
    "source_binding": { "type": "object", "additionalProperties": false, "required": ["content_hash", "byte_length", "raw_bytes_hash_recomputed", "source_record_hash", "extracted_text_hash_recomputed", "extracted_character_count_recomputed", "page_count_recomputed", "page_character_counts_recomputed"], "properties": { "content_hash": { "$ref": "#/$defs/hash" }, "byte_length": { "type": "integer", "minimum": 1 }, "raw_bytes_hash_recomputed": { "$ref": "#/$defs/hash" }, "source_record_hash": { "$ref": "#/$defs/hash" }, "extracted_text_hash_recomputed": { "$ref": "#/$defs/hash" }, "extracted_character_count_recomputed": { "type": "integer", "minimum": 0 }, "page_count_recomputed": { "type": "integer", "minimum": 0 }, "page_character_counts_recomputed": { "type": "array", "items": { "type": "integer", "minimum": 0 } } } },
    "locator": { "type": "object", "additionalProperties": false, "required": ["status", "kind", "page", "text_start", "text_end", "occurrence_count", "section_claimed", "section_independently_bound"], "properties": { "status": { "const": "exact" }, "kind": { "enum": ["pdf_page", "html_text_offset"] }, "page": { "type": ["integer", "null"] }, "text_start": { "type": ["integer", "null"] }, "text_end": { "type": ["integer", "null"] }, "occurrence_count": { "type": "integer", "minimum": 1 }, "section_claimed": { "type": ["string", "null"] }, "section_independently_bound": { "const": false } } },
    "unresolved": { "type": "object", "additionalProperties": false, "required": ["authorship", "scope", "date"], "properties": { "authorship": { "$ref": "#/$defs/strings" }, "scope": { "$ref": "#/$defs/strings" }, "date": { "$ref": "#/$defs/strings" } } },
    "exact_content_binding": { "type": "object", "additionalProperties": false, "required": ["normalized_excerpt", "extractor_locator", "adjudicator_locator_recomputed", "extractor_snippet_hash", "skeptic_snippet_hash_claimed", "skeptic_snippet_hash_recomputed", "adjudicator_snippet_hash_recomputed", "binding_status"], "properties": { "normalized_excerpt": { "type": "string", "minLength": 1 }, "extractor_locator": { "type": "object" }, "adjudicator_locator_recomputed": { "$ref": "#/$defs/locator" }, "extractor_snippet_hash": { "$ref": "#/$defs/hash" }, "skeptic_snippet_hash_claimed": { "$ref": "#/$defs/hash" }, "skeptic_snippet_hash_recomputed": { "$ref": "#/$defs/hash" }, "adjudicator_snippet_hash_recomputed": { "$ref": "#/$defs/hash" }, "binding_status": { "const": "exact" } } },
    "proposition": { "type": "object", "additionalProperties": false, "required": ["proposition_id", "statement", "exact_content_binding", "extractor_claim", "skeptic_claim", "final_verdict", "final_rationale", "agreements", "disagreements", "unresolved_questions", "review_hash"], "properties": { "proposition_id": { "type": "string", "minLength": 1 }, "statement": { "type": "string", "minLength": 1 }, "exact_content_binding": { "$ref": "#/$defs/exact_content_binding" }, "extractor_claim": { "type": "object", "additionalProperties": false, "required": ["support_strength", "adjudicator_relation"], "properties": { "support_strength": { "enum": ["direct", "partial", "contextual"] }, "adjudicator_relation": { "enum": ["agree", "qualified", "disagree", "unverifiable"] } } }, "skeptic_claim": { "type": "object", "additionalProperties": false, "required": ["support_verdict", "support_rationale", "challenges", "adjudicator_relation"], "properties": { "support_verdict": { "$ref": "#/$defs/verdict" }, "support_rationale": { "type": "string", "minLength": 1 }, "challenges": { "$ref": "#/$defs/strings" }, "adjudicator_relation": { "enum": ["agree", "disagree"] } } }, "final_verdict": { "$ref": "#/$defs/verdict" }, "final_rationale": { "type": "string", "minLength": 1 }, "agreements": { "$ref": "#/$defs/strings" }, "disagreements": { "$ref": "#/$defs/strings" }, "unresolved_questions": { "$ref": "#/$defs/unresolved" }, "review_hash": { "$ref": "#/$defs/hash" } } }
  }
}
