{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Zhao73/alphacouncil-agent/schemas/runtime-headless-portfolio-manager-decision-v1.schema.json",
  "title": "AlphaCouncil headless structured portfolio-manager decision",
  "allOf": [
    {
      "$ref": "https://github.com/Zhao73/alphacouncil-agent/schemas/runtime-debate-packet-v1.schema.json"
    },
    {
      "type": "object",
      "required": ["price_levels", "horizon_views", "data_gaps"],
      "properties": {
        "price_levels": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["label", "range", "meaning", "action", "basis", "source_ids"],
            "properties": {
              "label": { "type": "string", "pattern": "\\S" },
              "range": { "type": "string", "pattern": "\\S" },
              "meaning": { "type": "string", "pattern": "\\S" },
              "action": { "type": "string", "pattern": "\\S" },
              "basis": { "type": "string", "pattern": "\\S" },
              "source_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "maxLength": 512,
                  "pattern": "^[^\\s\\x00-\\x1F\\x7F]+$"
                }
              }
            },
            "additionalProperties": true
          }
        },
        "horizon_views": {
          "type": "object",
          "required": ["short_term", "medium_term", "long_term"],
          "properties": {
            "short_term": { "type": "string", "pattern": "\\S" },
            "medium_term": { "type": "string", "pattern": "\\S" },
            "long_term": { "type": "string", "pattern": "\\S" }
          },
          "additionalProperties": true
        },
        "data_gaps": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "\\S" }
        },
        "report_markdown": false
      }
    }
  ]
}
