{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Zhao73/alphacouncil-agent/schemas/persona-v3-ai-semantic-source-skeptic-review-v1.schema.json",
  "title": "AlphaCouncil round-2 AI semantic source skeptic review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_kind", "pipeline_id", "review_stage", "reviewer_kind", "role", "role_id", "prompt_identity", "model_identity", "reviewed_on", "human_reviewed", "method_attribution_approved", "production_effect", "persona_id", "candidate_id", "source_binding", "extractor_binding", "binding_checks", "readability_recheck", "proposition_reviews", "overall_verdict", "challenges", "open_questions", "artifact_hash"],
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_kind": { "const": "persona_v3_ai_semantic_source_skeptic_review" },
    "pipeline_id": { "const": "alphacouncil_ai_semantic_source_skeptic_v1" },
    "review_stage": { "const": "round_2_semantic_skeptic" },
    "reviewer_kind": { "const": "ai" },
    "role": { "const": "skeptic" },
    "role_id": { "const": "ai_semantic_source_skeptic_v1" },
    "prompt_identity": { "type": "object", "additionalProperties": false, "required": ["prompt_id", "prompt_hash"], "properties": { "prompt_id": { "const": "alphacouncil.source-semantic-skeptic.round2.v1" }, "prompt_hash": { "$ref": "#/$defs/hash" } } },
    "model_identity": { "type": "object", "additionalProperties": { "type": "string" }, "required": ["provider", "product", "model_family", "exact_deployment_id", "agent_task_id"] },
    "reviewed_on": { "type": "string", "format": "date" },
    "human_reviewed": { "const": false },
    "method_attribution_approved": { "const": false },
    "production_effect": { "const": "none" },
    "persona_id": { "type": "string", "pattern": "^master_[a-z0-9_]+$" },
    "candidate_id": { "type": "string", "minLength": 3 },
    "source_binding": { "type": "object", "additionalProperties": false, "required": ["content_hash", "byte_length", "raw_bytes_hash_recomputed", "raw_bytes_reverified", "source_record_hash", "source_record_hash_recomputed", "extracted_text_hash", "extracted_text_hash_recomputed"], "properties": { "content_hash": { "$ref": "#/$defs/hash" }, "byte_length": { "type": "integer", "minimum": 1 }, "raw_bytes_hash_recomputed": { "$ref": "#/$defs/hash" }, "raw_bytes_reverified": { "const": true }, "source_record_hash": { "$ref": "#/$defs/hash" }, "source_record_hash_recomputed": { "$ref": "#/$defs/hash" }, "extracted_text_hash": { "$ref": "#/$defs/hash" }, "extracted_text_hash_recomputed": { "$ref": "#/$defs/hash" } } },
    "extractor_binding": { "type": "object", "additionalProperties": false, "required": ["relative_path", "declared_artifact_hash", "recomputed_artifact_hash", "artifact_content_hash", "proposition_count"], "properties": { "relative_path": { "type": "string" }, "declared_artifact_hash": { "$ref": "#/$defs/hash" }, "recomputed_artifact_hash": { "$ref": "#/$defs/hash" }, "artifact_content_hash": { "$ref": "#/$defs/hash" }, "proposition_count": { "type": "integer", "minimum": 0 } } },
    "binding_checks": { "type": "object", "additionalProperties": false, "required": ["candidate_persona", "raw_bytes", "source_record", "extracted_text", "extractor_artifact"], "properties": { "candidate_persona": { "$ref": "#/$defs/check" }, "raw_bytes": { "$ref": "#/$defs/check" }, "source_record": { "$ref": "#/$defs/check" }, "extracted_text": { "$ref": "#/$defs/check" }, "extractor_artifact": { "$ref": "#/$defs/check" } } },
    "readability_recheck": { "type": "object", "additionalProperties": false, "required": ["extractor_status", "independent_status", "status_match", "reason"], "properties": { "extractor_status": { "$ref": "#/$defs/readability" }, "independent_status": { "$ref": "#/$defs/readability" }, "status_match": { "type": "boolean" }, "reason": { "type": "string", "minLength": 1 } } },
    "proposition_reviews": { "type": "array", "items": { "$ref": "#/$defs/proposition_review" } },
    "overall_verdict": { "$ref": "#/$defs/verdict" },
    "challenges": { "$ref": "#/$defs/strings" },
    "open_questions": { "$ref": "#/$defs/strings" },
    "artifact_hash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "readability": { "enum": ["readable", "partial", "unreadable"] },
    "verdict": { "enum": ["supported", "partial", "unsupported", "unverifiable"] },
    "strings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "check": { "type": "object", "additionalProperties": false, "required": ["status", "detail"], "properties": { "status": { "enum": ["pass", "fail"] }, "detail": { "type": "string", "minLength": 1 } } },
    "ambiguity": { "type": "object", "additionalProperties": false, "required": ["status", "rationale"], "properties": { "status": { "enum": ["none_detected", "limited", "material", "unknown"] }, "rationale": { "type": "string", "minLength": 1 } } },
    "locator_verification": { "type": "object", "additionalProperties": false, "required": ["status", "declared_kind", "declared_page", "actual_page", "actual_text_start", "actual_text_end", "occurrence_count", "section_label_status"], "properties": { "status": { "enum": ["exact", "mismatch", "unverifiable"] }, "declared_kind": { "enum": ["pdf_page", "html_text_offset"] }, "declared_page": { "type": ["integer", "null"] }, "actual_page": { "type": ["integer", "null"] }, "actual_text_start": { "type": ["integer", "null"] }, "actual_text_end": { "type": ["integer", "null"] }, "occurrence_count": { "type": "integer", "minimum": 0 }, "section_label_status": { "enum": ["extractor_label_not_independently_bound", "absent"] } } },
    "proposition_review": { "type": "object", "additionalProperties": false, "required": ["proposition_id", "proposed_statement", "proposed_support_strength", "proposed_evidence_excerpt", "proposed_locator", "snippet_hash_claimed", "snippet_hash_recomputed", "snippet_binding_status", "locator_verification", "support_verdict", "support_rationale", "authorship_ambiguity", "scope_ambiguity", "date_ambiguity", "challenges", "open_questions", "review_hash"], "properties": { "proposition_id": { "type": "string" }, "proposed_statement": { "type": "string" }, "proposed_support_strength": { "enum": ["direct", "partial", "contextual"] }, "proposed_evidence_excerpt": { "type": "string" }, "proposed_locator": { "type": "object" }, "snippet_hash_claimed": { "$ref": "#/$defs/hash" }, "snippet_hash_recomputed": { "$ref": "#/$defs/hash" }, "snippet_binding_status": { "enum": ["exact", "mismatch", "unverifiable"] }, "locator_verification": { "$ref": "#/$defs/locator_verification" }, "support_verdict": { "$ref": "#/$defs/verdict" }, "support_rationale": { "type": "string", "minLength": 1 }, "authorship_ambiguity": { "$ref": "#/$defs/ambiguity" }, "scope_ambiguity": { "$ref": "#/$defs/ambiguity" }, "date_ambiguity": { "$ref": "#/$defs/ambiguity" }, "challenges": { "$ref": "#/$defs/strings" }, "open_questions": { "$ref": "#/$defs/strings" }, "review_hash": { "$ref": "#/$defs/hash" } } }
  }
}
