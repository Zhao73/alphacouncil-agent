{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Zhao73/alphacouncil-agent/schemas/typed-fact-v1.schema.json",
  "title": "AlphaCouncil typed fact v1",
  "description": "A point-in-time fact with units, period, source lineage and derivation. Temporal ordering is enforced by runtime code because JSON Schema cannot compare timestamps.",
  "type": "object",
  "required": [
    "schema_version",
    "fact_id",
    "value_kind",
    "value",
    "unit",
    "currency",
    "scale",
    "period_start",
    "period_end",
    "fiscal_year",
    "as_of",
    "public_at",
    "source_ids",
    "derivation",
    "confidence",
    "restatement_policy",
    "lineage"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "fact_id": { "type": "string", "pattern": "^[a-z0-9_.:-]{3,160}$" },
    "value_kind": { "enum": ["monetary", "ratio", "count", "scalar", "boolean", "text", "date"] },
    "value": { "type": ["number", "string", "boolean", "null"] },
    "unit": { "type": ["string", "null"] },
    "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
    "scale": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "ratio_denominator": { "type": ["string", "null"] },
    "period_start": { "type": ["string", "null"] },
    "period_end": { "type": ["string", "null"] },
    "fiscal_year": { "type": ["integer", "null"], "minimum": 1800, "maximum": 3000 },
    "as_of": { "type": "string", "minLength": 10 },
    "public_at": { "type": "string", "minLength": 10 },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 512,
        "pattern": "^[^\\s\\x00-\\x1F\\x7F]+$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "derivation": { "enum": ["reported", "rederived", "estimated", "qualitative_extraction"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "restatement_policy": { "type": "string", "minLength": 1 },
    "lineage": {
      "type": "object",
      "required": ["input_fact_ids", "tool_id", "tool_version", "calculation_hash"],
      "additionalProperties": false,
      "properties": {
        "input_fact_ids": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "tool_id": { "type": ["string", "null"] },
        "tool_version": { "type": ["string", "null"] },
        "calculation_hash": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  }
}
