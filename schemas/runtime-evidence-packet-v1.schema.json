{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Zhao73/alphacouncil-agent/schemas/runtime-evidence-packet-v1.schema.json",
  "title": "AlphaCouncil headless evidence worker packet",
  "type": "object",
  "required": ["summary", "claims", "metrics", "sources", "open_questions", "confidence"],
  "properties": {
    "summary": { "type": "string", "pattern": "\\S" },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "evidence", "confidence", "source_ids"],
        "properties": {
          "claim": { "type": "string", "pattern": "\\S" },
          "evidence": { "type": "string", "pattern": "\\S" },
          "confidence": { "enum": ["high", "medium", "low"] },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "maxLength": 512,
              "pattern": "^[^\\s\\x00-\\x1F\\x7F]+$"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "metrics": { "type": "object" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "url", "published_at", "retrieved_at"],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 512,
            "pattern": "^[^\\s\\x00-\\x1F\\x7F]+$"
          },
          "title": { "type": "string", "pattern": "\\S" },
          "url": { "type": "string", "pattern": "\\S" },
          "published_at": { "type": "string", "pattern": "\\S" },
          "retrieved_at": { "type": "string", "pattern": "\\S" }
        },
        "additionalProperties": true
      }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string", "pattern": "\\S" }
    },
    "coverage_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "source_ids"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z0-9_.]+$" },
          "status": { "enum": ["covered", "unavailable", "not_applicable"] },
          "source_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 512,
              "pattern": "^[^\\s\\x00-\\x1F\\x7F]+$"
            }
          },
          "note": { "type": "string" },
          "attempted": { "type": "string" },
          "attempted_urls": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "format": "uri", "pattern": "^https?://" }
          },
          "gap": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "acquisition_ledger": {
      "type": "object",
      "description": "Worker-proposed acquisition audit. Exact policy, task ownership, rows, attempts and outcome semantics are canonicalized and validated against the frozen per-run plan after transport parsing.",
      "additionalProperties": true
    },
    "confidence": { "enum": ["high", "medium", "low"] },
    "information_richness": { "enum": ["A", "B", "C", "unrated"] }
  },
  "anyOf": [
    { "properties": { "claims": { "type": "array", "minItems": 1 } } },
    { "properties": { "open_questions": { "type": "array", "minItems": 1 } } }
  ],
  "additionalProperties": true
}
