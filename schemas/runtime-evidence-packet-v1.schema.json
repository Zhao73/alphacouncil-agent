{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Zhao73/alphacouncil-agent/schemas/runtime-evidence-packet-v1.schema.json",
  "title": "AlphaCouncil headless evidence worker packet",
  "type": "object",
  "required": ["summary", "claims", "metrics", "sources", "open_questions", "confidence"],
  "properties": {
    "summary": { "type": "string", "pattern": "\\S" },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "evidence", "confidence", "source_ids"],
        "properties": {
          "claim": { "type": "string", "pattern": "\\S" },
          "evidence": { "type": "string", "pattern": "\\S" },
          "confidence": { "enum": ["high", "medium", "low"] },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "maxLength": 512,
              "pattern": "^[^\\s\\x00-\\x1F\\x7F]+$"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "metrics": { "type": "object" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "url", "published_at", "retrieved_at"],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 512,
            "pattern": "^[^\\s\\x00-\\x1F\\x7F]+$"
          },
          "title": { "type": "string", "pattern": "\\S" },
          "url": { "type": "string", "pattern": "\\S" },
          "published_at": { "type": "string", "pattern": "\\S" },
          "retrieved_at": { "type": "string", "pattern": "\\S" }
        },
        "additionalProperties": true
      }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string", "pattern": "\\S" }
    },
    "coverage_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "source_ids"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z0-9_.]+$" },
          "status": { "enum": ["covered", "unavailable", "not_applicable"] },
          "source_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 512,
              "pattern": "^[^\\s\\x00-\\x1F\\x7F]+$"
            }
          },
          "note": { "type": "string" },
          "attempted": { "type": "string" },
          "attempted_urls": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "format": "uri", "pattern": "^https?://" }
          },
          "gap": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "acquisition_ledger": {
      "type": "object",
      "required": ["policy_id", "task", "items"],
      "properties": {
        "policy_id": { "const": "company_source_acquisition_v1" },
        "task": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["coverage_id", "outcome", "source_ids", "attempts"],
            "properties": {
              "coverage_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z0-9_.]+$" },
              "outcome": {
                "enum": ["reported_actual", "recomputed_proxy", "modeled_estimate", "unavailable", "not_applicable"]
              },
              "source_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "maxLength": 512,
                  "pattern": "^[^\\s\\x00-\\x1F\\x7F]+$"
                }
              },
              "attempts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["stage", "locator_type", "locator", "result", "source_ids"],
                  "properties": {
                    "stage": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                    "locator_type": { "enum": ["url", "query", "local"] },
                    "locator": { "type": "string", "pattern": "\\S" },
                    "result": {
                      "enum": ["succeeded", "not_found", "not_disclosed", "unreachable", "blocked", "not_applicable"]
                    },
                    "source_ids": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "maxLength": 512,
                        "pattern": "^[^\\s\\x00-\\x1F\\x7F]+$"
                      }
                    },
                    "note": { "type": "string" }
                  },
                  "additionalProperties": true
                }
              },
              "data": { "type": "object" },
              "reason": { "type": "string" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "confidence": { "enum": ["high", "medium", "low"] },
    "information_richness": { "enum": ["A", "B", "C", "unrated"] }
  },
  "anyOf": [
    { "properties": { "claims": { "type": "array", "minItems": 1 } } },
    { "properties": { "open_questions": { "type": "array", "minItems": 1 } } }
  ],
  "additionalProperties": true
}
