{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Zhao73/alphacouncil-agent/schemas/runtime-evidence-packet-v1.schema.json",
  "title": "AlphaCouncil headless evidence worker packet",
  "type": "object",
  "required": ["summary", "claims", "metrics", "sources", "open_questions", "confidence"],
  "properties": {
    "summary": { "type": "string", "pattern": "\\S" },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "evidence", "confidence", "source_ids"],
        "properties": {
          "claim": { "type": "string", "pattern": "\\S" },
          "evidence": { "type": "string", "pattern": "\\S" },
          "confidence": { "enum": ["high", "medium", "low"] },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "\\S" }
          }
        },
        "additionalProperties": true
      }
    },
    "metrics": { "type": "object" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "url", "published_at", "retrieved_at"],
        "properties": {
          "id": { "type": "string", "pattern": "\\S" },
          "title": { "type": "string", "pattern": "\\S" },
          "url": { "type": "string", "pattern": "\\S" },
          "published_at": { "type": "string", "pattern": "\\S" },
          "retrieved_at": { "type": "string", "pattern": "\\S" }
        },
        "additionalProperties": true
      }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string", "pattern": "\\S" }
    },
    "confidence": { "enum": ["high", "medium", "low"] },
    "information_richness": { "enum": ["A", "B", "C", "unrated"] }
  },
  "anyOf": [
    { "properties": { "claims": { "type": "array", "minItems": 1 } } },
    { "properties": { "open_questions": { "type": "array", "minItems": 1 } } }
  ],
  "additionalProperties": true
}
