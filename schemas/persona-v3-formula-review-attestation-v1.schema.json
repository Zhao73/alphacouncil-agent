{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Zhao73/alphacouncil-agent/schemas/persona-v3-formula-review-attestation-v1.schema.json",
  "title": "AlphaCouncil PersonaPack v3 formula review attestation v1",
  "description": "One explicit human Ed25519 review of a complete formula spec, its prototype hash, source IDs and authorship metadata.",
  "type": "object",
  "required": [
    "schema_version", "artifact_kind", "formula_spec_id", "tool_id", "formula_spec_hash",
    "review_subject_hash", "prototype_content_hash", "source_ids", "author_id", "authored_at",
    "reviewer_id", "signer_key_id", "decision", "reviewed_at", "signature"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_kind": { "const": "persona_v3_formula_review_attestation" },
    "formula_spec_id": { "$ref": "#/$defs/id" },
    "tool_id": { "$ref": "#/$defs/id" },
    "formula_spec_hash": { "$ref": "#/$defs/hash" },
    "review_subject_hash": { "$ref": "#/$defs/hash" },
    "prototype_content_hash": { "$ref": "#/$defs/hash" },
    "source_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "author_id": { "type": "string", "minLength": 1 },
    "authored_at": { "type": "string", "format": "date-time" },
    "reviewer_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "signer_key_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{3,128}$" },
    "decision": { "enum": ["approve", "reject"] },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "signature": { "type": "string", "pattern": "^ed25519:[A-Za-z0-9_-]{86}$" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,159}$" },
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
