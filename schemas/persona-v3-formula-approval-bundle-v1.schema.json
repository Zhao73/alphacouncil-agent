{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Zhao73/alphacouncil-agent/schemas/persona-v3-formula-approval-bundle-v1.schema.json",
  "title": "AlphaCouncil PersonaPack v3 formula approval bundle v1",
  "description": "The complete formula spec plus at least two Ed25519 reviews. Runtime validation additionally requires distinct trusted formula_review principals and exact cross-field hashes.",
  "type": "object",
  "required": [
    "schema_version", "artifact_kind", "formula_spec", "formula_spec_hash",
    "review_subject_hash", "prototype_content_hash", "source_ids", "author_id", "authored_at",
    "attestations"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_kind": { "const": "persona_v3_formula_approval_bundle" },
    "formula_spec": { "$ref": "persona-v3-formula-spec-v1.schema.json" },
    "formula_spec_hash": { "$ref": "#/$defs/hash" },
    "review_subject_hash": { "$ref": "#/$defs/hash" },
    "prototype_content_hash": { "$ref": "#/$defs/hash" },
    "source_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "author_id": { "type": "string", "minLength": 1 },
    "authored_at": { "type": "string", "format": "date-time" },
    "attestations": {
      "type": "array", "minItems": 2,
      "items": { "$ref": "persona-v3-formula-review-attestation-v1.schema.json" }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
