{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Zhao73/alphacouncil-agent/schemas/persona-v3-release-approval-v1.schema.json",
  "title": "AlphaCouncil PersonaPack v3 release approval bundle",
  "description": "Dual-principal Ed25519 approval for one exact cutover or rollback. Runtime validity requires an external trusted key registry whose key purpose includes persona_release; signer ids alone are never authority.",
  "type": "object",
  "required": [
    "schema_version", "artifact_kind", "operation", "release_id",
    "release_manifest_hash", "previous_release_id", "approvals"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_kind": { "const": "persona_v3_release_approval_bundle" },
    "operation": { "enum": ["cutover", "rollback"] },
    "release_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "release_manifest_hash": { "$ref": "#/$defs/hash" },
    "previous_release_id": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" }
      ]
    },
    "approvals": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/approval" }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "approval": {
      "type": "object",
      "required": ["reviewer_id", "signer_key_id", "approved_at", "signature"],
      "additionalProperties": false,
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "signer_key_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{3,128}$" },
        "approved_at": { "type": "string", "format": "date-time" },
        "signature": { "type": "string", "pattern": "^ed25519:[A-Za-z0-9_-]{86}$" }
      }
    }
  }
}
