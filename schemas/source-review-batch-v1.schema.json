{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Zhao73/alphacouncil-agent/schemas/source-review-batch-v1.schema.json",
  "title": "AlphaCouncil PersonaPack v3 human source review batch v1",
  "description": "Read-only operational export of raw acquisition bindings, human proposal work, immutable hashes, exact locator gaps and trusted-principal quorum progress across the canonical 26 seats.",
  "type": "object",
  "required": [
    "schema_version", "artifact_kind", "canonical_master_count", "reviewer_instructions",
    "progress", "personas", "generated_at", "batch_hash"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_kind": { "const": "persona_v3_source_review_batch" },
    "canonical_master_count": { "const": 26 },
    "reviewer_instructions": {
      "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }
    },
    "progress": { "$ref": "#/$defs/progress" },
    "personas": {
      "type": "array", "minItems": 26, "maxItems": 26,
      "items": { "$ref": "#/$defs/persona" }
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "batch_hash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "progress": {
      "type": "object",
      "required": [
        "seat_count", "seats_with_raw_acquisition", "raw_acquisition_count",
        "proposal_pending_count", "prepared_source_count", "trusted_quorum_source_count",
        "invalid_seat_count", "all_26_seats_acquired", "all_candidates_prepared",
        "all_prepared_sources_have_two_distinct_trusted_principals",
        "all_26_seats_have_a_two_principal_quorum_source", "production_write_count"
      ],
      "additionalProperties": false,
      "properties": {
        "seat_count": { "const": 26 },
        "seats_with_raw_acquisition": { "type": "integer", "minimum": 0, "maximum": 26 },
        "raw_acquisition_count": { "type": "integer", "minimum": 0 },
        "proposal_pending_count": { "type": "integer", "minimum": 0 },
        "prepared_source_count": { "type": "integer", "minimum": 0 },
        "trusted_quorum_source_count": { "type": "integer", "minimum": 0 },
        "invalid_seat_count": { "type": "integer", "minimum": 0, "maximum": 26 },
        "all_26_seats_acquired": { "type": "boolean" },
        "all_candidates_prepared": { "type": "boolean" },
        "all_prepared_sources_have_two_distinct_trusted_principals": { "type": "boolean" },
        "all_26_seats_have_a_two_principal_quorum_source": { "type": "boolean" },
        "production_write_count": { "const": 0 }
      }
    },
    "persona": {
      "type": "object",
      "required": ["persona_id", "candidate_count", "prepared_count", "trusted_quorum_count", "errors", "candidates"],
      "additionalProperties": false,
      "properties": {
        "persona_id": { "type": "string", "pattern": "^[a-z0-9_]{2,48}$" },
        "candidate_count": { "type": "integer", "minimum": 0 },
        "prepared_count": { "type": "integer", "minimum": 0 },
        "trusted_quorum_count": { "type": "integer", "minimum": 0 },
        "errors": { "type": "array", "items": { "type": "string" } },
        "candidates": { "type": "array", "items": { "$ref": "#/$defs/candidate" } }
      }
    },
    "candidate": {
      "type": "object",
      "required": [
        "candidate_id", "source_id", "workflow_state", "raw_acquisition", "proposal",
        "proposal_template", "proposal_hash", "proposal_pending_fields", "exact_locator",
        "exact_locator_pending", "content_hash", "anchor_hash", "unsigned_review_template",
        "trusted_quorum"
      ],
      "additionalProperties": false,
      "properties": {
        "candidate_id": { "type": "string" },
        "source_id": { "type": ["string", "null"] },
        "workflow_state": { "enum": ["awaiting_human_proposal", "prepared_for_human_review"] },
        "raw_acquisition": { "type": "object" },
        "proposal": { "type": ["object", "null"] },
        "proposal_template": { "type": ["object", "null"] },
        "proposal_hash": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
        "proposal_pending_fields": { "type": "array", "items": { "type": "string" } },
        "exact_locator": { "type": ["object", "null"] },
        "exact_locator_pending": { "type": "boolean" },
        "content_hash": { "$ref": "#/$defs/hash" },
        "anchor_hash": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
        "unsigned_review_template": { "type": ["object", "null"] },
        "trusted_quorum": { "type": "object" }
      }
    }
  }
}
