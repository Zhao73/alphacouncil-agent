{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Zhao73/alphacouncil-agent/schemas/source-adjudication-ledger-v1.schema.json",
  "title": "AlphaCouncil source-adjudication ledger v1",
  "description": "Non-production staging ledger binding acquisition bytes, the exact human proposal, and a hash-chained sequence of human review attestations.",
  "type": "object",
  "required": ["schema_version", "artifact_kind", "persona_id", "records"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_kind": { "const": "source_adjudication_ledger" },
    "persona_id": { "type": "string", "pattern": "^[a-z0-9_]{2,48}$" },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/ledgerRecord" }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "ledgerRecord": {
      "type": "object",
      "required": [
        "schema_version", "persona_id", "candidate_id", "source_id", "status",
        "status_reason", "acquisition", "proposal", "proposal_hash", "anchor_hash",
        "prepared_at", "review_attestations", "attestation_chain_head"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": 1 },
        "persona_id": { "type": "string", "pattern": "^[a-z0-9_]{2,48}$" },
        "candidate_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,62}[a-z0-9]$" },
        "source_id": { "type": "string", "pattern": "^[a-z0-9_:-]{3,128}$" },
        "status": { "enum": ["pending", "approved", "rejected", "blocked"] },
        "status_reason": { "type": "string", "minLength": 1 },
        "acquisition": {
          "type": "object",
          "required": ["record_path", "archive_path", "record_hash", "content_hash", "byte_length"],
          "additionalProperties": false,
          "properties": {
            "record_path": { "type": "string", "pattern": "^acquisitions/candidates/[a-z0-9][a-z0-9_-]{1,62}[a-z0-9]/record\\.json$" },
            "archive_path": { "type": "string", "pattern": "^acquisitions/candidates/[a-z0-9][a-z0-9_-]{1,62}[a-z0-9]/source\\.bin$" },
            "record_hash": { "$ref": "#/$defs/hash" },
            "content_hash": { "$ref": "#/$defs/hash" },
            "byte_length": { "type": "integer", "minimum": 1 }
          }
        },
        "proposal": { "$ref": "source-anchor-proposal-v1.schema.json" },
        "proposal_hash": { "$ref": "#/$defs/hash" },
        "anchor_hash": { "$ref": "#/$defs/hash" },
        "prepared_at": { "type": "string", "format": "date-time" },
        "review_attestations": {
          "type": "array",
          "items": { "$ref": "#/$defs/persistedAttestation" }
        },
        "attestation_chain_head": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] }
      }
    },
    "persistedAttestation": {
      "type": "object",
      "required": [
        "schema_version", "artifact_kind", "reviewer_id", "normalized_reviewer_id",
        "signer_key_id", "decision", "content_hash", "anchor_hash", "reviewed_at",
        "affirmations", "notes", "signature", "previous_attestation_hash",
        "attestation_hash"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": 2 },
        "artifact_kind": { "const": "persona_v3_source_review_attestation" },
        "reviewer_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": ".*\\S.*" },
        "normalized_reviewer_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "signer_key_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{3,128}$" },
        "decision": { "enum": ["approve", "reject"] },
        "content_hash": { "$ref": "#/$defs/hash" },
        "anchor_hash": { "$ref": "#/$defs/hash" },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "affirmations": {
          "type": "object",
          "required": [
            "reviewed_raw_archive_bytes", "verified_locator_against_raw_material",
            "reviewer_is_human", "review_was_independent"
          ],
          "additionalProperties": false,
          "properties": {
            "reviewed_raw_archive_bytes": { "const": true },
            "verified_locator_against_raw_material": { "const": true },
            "reviewer_is_human": { "const": true },
            "review_was_independent": { "const": true }
          }
        },
        "notes": { "type": "string", "maxLength": 1200 },
        "signature": { "type": "string", "pattern": "^ed25519:[A-Za-z0-9_-]{86}$" },
        "previous_attestation_hash": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
        "attestation_hash": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
