{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Zhao73/alphacouncil-agent/schemas/source-anchor-proposal-v1.schema.json",
  "title": "AlphaCouncil human source-anchor proposal v1",
  "description": "Human-supplied metadata for binding already archived bytes to a proposed source anchor. No field in this artifact may be inferred by code or a language model.",
  "type": "object",
  "required": [
    "schema_version", "artifact_kind", "persona_id", "candidate_id", "source_id",
    "source_kind", "grade", "author", "title", "url", "published_at", "public_at",
    "locator", "summary", "supports"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_kind": { "const": "persona_v3_source_anchor_proposal" },
    "persona_id": { "type": "string", "pattern": "^[a-z0-9_]{2,48}$" },
    "candidate_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,62}[a-z0-9]$" },
    "source_id": { "type": "string", "pattern": "^[a-z0-9_:-]{3,128}$" },
    "source_kind": { "enum": ["primary_text", "primary_behavior", "derived_proxy", "empirical_calibration", "editorial_choice"] },
    "grade": { "enum": ["A", "B", "C", "D", "E"] },
    "author": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "pattern": "^https?://" },
    "published_at": { "type": "string", "minLength": 10 },
    "public_at": { "type": "string", "minLength": 10 },
    "known_at": { "type": ["string", "null"] },
    "locator": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "page": { "type": ["string", "integer"] },
        "chapter": { "type": "string", "minLength": 1 },
        "section": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "minLength": 1 },
        "filing_item": { "type": "string", "minLength": 1 }
      }
    },
    "summary": { "type": "string", "minLength": 8, "maxLength": 1200 },
    "excerpt": { "type": "string", "maxLength": 400 },
    "supports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
