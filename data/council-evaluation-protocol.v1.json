  "registration": {
    "registered_at": null,
    "registration_hash": null,
    "dataset_hash": null,
    "case_ledger_hash": null,
    "model_matrix_hash": null,
    "prompt_bundle_hash": null,
    "runner_hash": null,
    "host_matrix_hash": null,
    "randomization_hash": null,
    "adjudication_rubric_hash": null,
    "signer_key_id": null,
    "signature": null
  },
  "case_design": {
    "case_unit": "company_x_as_of_x_event",
    "minimum_shared_cases": 48,
    "minimum_historical_clusters": 36,
    "cluster_keys": ["issuer", "event", "market_regime"],
    "same_frozen_cases_across_machine_arms": true,
    "human_arm_receives_same_case_question": true,
    "prospective_shadow_cases_required": true,
    "shadow_beta_interpretation": "operational_only_not_outcome_validation",
    "returns_role": "recorded_lagging_outcome_never_a_standalone_promotion_gate"
  },
  "point_in_time_controls": {
    "fact_visibility_rule": "public_at <= as_of AND known_at <= as_of",
    "filing_visibility_rule": "filed_at <= as_of",
    "memory_visibility_rule": "public_at <= as_of AND memory_created_at <= as_of",
    "prediction_freeze_rule": "all_arm_predictions_frozen_before_outcome_or_adjudication_access",
    "outcome_visibility": "withheld_until_prediction_freeze",
    "restatement_rule": "use_only_restatements_public_by_as_of",
    "source_retrieval_log_required": true
  },
  "anti_leakage_controls": {
    "frozen_case_membership_before_execution": true,
    "frozen_arm_order_before_execution": true,
    "survivorship_universe_as_of_required": true,
    "prompt_model_runner_host_hashes_required": true,
    "post_as_of_search_results_forbidden": true,
    "cross_arm_context_sharing_forbidden": true,
    "human_adjudicators_blinded_to_arm": true,
    "case_outcomes_hidden_from_models": true,
    "known_training_contamination_recorded_not_self_cleared": true,
    "threshold_tuning_on_shadow_beta_forbidden": true
  },
  "resource_accounting": {
    "record_wall_clock_critical_path": true,
    "record_cpu_time_when_available": true,
    "record_model_input_tokens": true,
    "record_model_output_tokens": true,
    "record_tool_calls": true,
    "record_network_requests": true,
    "record_provider_billed_cost": true,
    "record_failed_and_retried_work": true,
    "matched_cost_secondary_analysis_required": true,
    "unmatched_quality_and_cost_reported_together": true
  },
  "adjudication": {
    "material_claim_unit": "normalized_claim_cluster",
    "fact_adjudicators_minimum": 2,
    "disagreement_adjudicator_count": 1,
    "arm_identity_blinded": true,
    "source_documents_visible_to_adjudicators": true,
    "native_decisions_scored_before_common_projection": true,
    "agreement_reported_separately_from_independence": true,
    "n_eff_policy": "separate_preregistered_resolved_outcome_protocol_or_null"
  },
  "metrics": [
    {
      "metric_id": "fact_accuracy",
      "family": "fact",
      "estimand": "adjudicated_correct_material_fact_claims_divided_by_all_adjudicated_material_fact_claims",
      "unit": "ratio",
      "direction": "higher_is_better",
      "aggregation": "paired_case_micro_and_cluster_bootstrap",
      "reported_statistics": ["point_estimate", "confidence_interval", "case_coverage"],
      "requires_blind_adjudication": true,
      "result": null
    },
    {
      "metric_id": "citation_validity",
      "family": "citation",
      "estimand": "material_claim_citations_that_entail_the_claim_and_respect_as_of_divided_by_all_material_claim_citations",
      "unit": "ratio",
      "direction": "higher_is_better",
      "aggregation": "paired_case_micro_and_cluster_bootstrap",
      "reported_statistics": ["point_estimate", "confidence_interval", "source_reachability"],
      "requires_blind_adjudication": true,
      "result": null
    },
    {
      "metric_id": "calibration",
      "family": "calibration",
      "estimand": "multiclass_brier_score_on_frozen_common_projection_for_cases_with_resolved_labels",
      "unit": "brier_score",
      "direction": "lower_is_better",
      "aggregation": "paired_case_mean_and_cluster_bootstrap",
      "reported_statistics": ["point_estimate", "confidence_interval", "reliability_by_bin"],
      "requires_blind_adjudication": true,
      "result": null
    },
    {
      "metric_id": "abstention_quality",
      "family": "abstention",
      "estimand": "selective_error_at_observed_coverage_plus_penalty_for_answering_cases_missing_preregistered_critical_facts",
      "unit": "selective_risk",
      "direction": "lower_is_better",
      "aggregation": "paired_case_mean_with_coverage_curve",
      "reported_statistics": ["selective_risk", "coverage", "appropriate_abstention_rate", "false_confidence_rate"],
      "requires_blind_adjudication": true,
      "result": null
    },
    {
      "metric_id": "unique_information_contribution",
      "family": "unique_contribution",
      "estimand": "new_independently_verified_material_fact_clusters_absent_from_the_paired_base_arm_per_case",
      "unit": "verified_fact_clusters_per_case",
      "direction": "higher_is_better",
      "aggregation": "paired_case_mean_and_cluster_bootstrap",
      "reported_statistics": ["point_estimate", "confidence_interval", "source_cluster_count"],
      "requires_blind_adjudication": true,
      "result": null
    },
    {
      "metric_id": "cost",
      "family": "cost",
      "estimand": "measured_provider_cost_including_successful_failed_and_retried_work_per_completed_case",
      "unit": "usd_per_completed_case",
      "direction": "lower_is_better",
      "aggregation": "median_mean_and_total_by_arm",
      "reported_statistics": ["total_cost", "cost_per_case", "input_tokens", "output_tokens", "tool_calls"],
      "requires_blind_adjudication": false,
      "result": null
    },
    {
      "metric_id": "latency",
      "family": "latency",
      "estimand": "wall_clock_critical_path_from_frozen_input_release_to_final_frozen_output",
      "unit": "seconds",
      "direction": "lower_is_better",
      "aggregation": "p50_p95_and_max_by_arm",
      "reported_statistics": ["p50", "p95", "maximum", "timeout_rate"],
      "requires_blind_adjudication": false,
      "result": null
    }
  ],
