{
  "schema_version": 1,
  "protocol_id": "alphacouncil_canonical_arm_comparison_v1",
  "protocol_status": "draft_unregistered",
  "purpose": "Compare council configurations without treating seat count, agreement, tone, or an unsigned draft as evidence of quality or independence.",
  "canonical_arm_order": ["A", "B", "C", "D13", "D26", "E", "H"],
  "registry_snapshot": {
